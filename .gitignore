node_modules/
dist/
.env
.env.local
.DS_Store
.vscode/

# Backtest data archives (large generated files)
nest/data/backtest-archive/*.gz

# Logs (generated at runtime)
nest/logs/

# ⚠️ Log FILES repo-wide (2026-09-16). Deliberately `*.log`, NOT `logs/`.
#
# `nest/logs/` was ignored but the root `logs/` directory and the MT5 bridge logs were not, so
# 56 log files (~7.5 MB) were TRACKED and rewritten on every run. The cost is not disk — it is
# that the working tree is permanently dirty, so a real change is indistinguishable from log
# churn and `git status` stops being a signal.
#
# ⚠️ WHY NOT `logs/` AS A DIRECTORY. That directory is NOT scratch: it holds
#   • logs/scoring/*.jsonl — written by scoring-log.service.ts, served by /api/logs/scoring/*
#   • screenshots kept as evidence (lad-*.png, tape-settings*.png)
#   • live.json
# A blanket `logs/` rule would hide a live data directory alongside the logs. Only the log
# extensions are ignored; the rest stays tracked and visible.
*.log
*.log.err

# Python bytecode from the MT5 bridge and its canary — never tracked.
# `test_bridge_offset_guard.py` imports `mt5_bridge_v2.py` by path, which writes a
# __pycache__/ dir on every run.
__pycache__/
*.pyc

# Agent coordination cache (generated by scripts/agent-claim.cjs)
.github/issue-cache/snapshot.md

# Generated third-party attribution — NOT tracked, on purpose.
# scripts/generate-third-party-notices.cjs derives it from the installed dependency tree, so a
# tracked copy would be a second source of truth that silently drifts whenever a dependency moves.
# The publisher regenerates it into the release folder at package time, which is the only copy
# that matters. Run `npm run notices` when you want to read it locally.
THIRD-PARTY-NOTICES.txt

# Free-edition release artefacts (scripts/publish-free-release.cjs). Build output + the zip and
# its checksum, which are attached to the release rather than committed.
dist-free/
dist-free-release/
trading-command-suite-free-*.zip
trading-command-suite-free-*.zip.sha256

