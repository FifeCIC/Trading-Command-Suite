{
  "name": "nest",
  "version": "0.23.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "prisma": {
    "seed": "ts-node prisma/seed.ts",
    "seed:market-data": "ts-node prisma/seed-market-data.ts",
    "seed:faq": "ts-node prisma/seed-faq.ts",
    "seed:strategies": "ts-node prisma/seed-strategies.ts"
  },
  "scripts": {
    "prebuild": "node scripts/build-preflight.cjs && npx rimraf dist && npx prisma generate && node scripts/validate-protocol-directions.cjs && node scripts/validate-directive-group-kind.cjs && node scripts/validate-pipeline-contracts.cjs && node scripts/validate-threshold-sources.cjs && node scripts/validate-timeframe-sources.cjs && node scripts/validate-timezone-sources.cjs && node scripts/validate-local-time-sources.cjs && node scripts/validate-retention-columns.cjs && node scripts/validate-archive-default-column.cjs && node scripts/validate-collation-consistency.cjs && node scripts/validate-bot-rules.cjs && node scripts/validate-risk-profile.cjs && node ../scripts/validate-agent-docs.cjs && node ../scripts/validate-text-encoding.cjs && node ../scripts/validate-roadmap-columns.cjs && node ../scripts/validate-notices.cjs && node --test ../src/core/notices/notices.test.js && node ../scripts/validate-css-tokens.cjs && node ../scripts/docs-facts.cjs --check && node scripts/validate-settings-access.cjs",
    "build": "tsc -p tsconfig.build.json",
    "build:api": "pwsh -File ../scripts/build-api.ps1",
    "prisma:generate": "prisma generate",
    "db:check": "node scripts/validate-schema-safety.cjs",
    "db:config-refs": "node scripts/validate-config-db-refs.cjs",
    "db:fix-local-time": "node scripts/fix-local-time-writes.cjs && node scripts/fix-local-time-defaults.cjs",
    "db:push": "node -e \"console.error('\\n[db:push] BLOCKED. This repo has 10 raw-managed tables that are NOT in schema.prisma, so `prisma db push` would DROP them (incl. strategy_signal_queue and 195k backup rows).\\n\\nRun `npm run db:check` to see them. To add a column: ALTER TABLE ... ; npx prisma generate\\n'); process.exit(1)\"",
    "db:unsafe-push-I-have-read-the-warning": "node scripts/validate-schema-safety.cjs && prisma db push",
    "seed:watchlists": "ts-node prisma/seed-watchlists.ts",
    "seed:symbol-onboarding": "ts-node prisma/seed-symbol-onboarding.ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "build:preflight": "node scripts/build-preflight.cjs",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "audit:directives": "node scripts/directive-guard.cjs",
    "audit:data-health": "node scripts/audit-data-health.cjs",
    "audit:gate-membership": "node scripts/validate-directive-group-kind.cjs",
    "audit:gate-membership:test": "node scripts/test-gate-membership-guard.cjs",
    "audit:circular-work": "node ../scripts/detect-circular-work.cjs",
    "audit:seed-drift": "node ../scripts/diff-seed-vs-db.cjs",
    "audit:agent-docs": "node ../scripts/validate-agent-docs.cjs",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "conformance": "node scripts/directive-conformance.cjs",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:e2e:playwright": "npx playwright test --config e2e/playwright.config.ts",
    "test:e2e:playwright:ui": "npx playwright test --config e2e/playwright.config.ts --ui"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/platform-socket.io": "^11.1.24",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/websockets": "^11.1.24",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^5.22.0",
    "body-parser": "^2.3.0",
    "bullmq": "^5.78.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "ioredis": "^5.11.1",
    "pg": "^8.21.0",
    "reflect-metadata": "^0.2.2",
    "rss-parser": "^3.13.0",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "prisma": "^5.22.0",
    "rimraf": "^6.1.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
