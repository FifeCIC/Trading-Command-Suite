# App
PORT=3201
NODE_ENV=development

# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/trader_core?schema=public"

# Redis / BullMQ
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Queue Mode: off | local
# off = no Redis/queue initialization (default for local dev)
# local = enable queue if Redis is available
QUEUE_MODE=off

# ─── Alpaca Markets (Paper Trading) ─────────────────────────
# Free tier supports:
#   - Paper trading: unlimited
#   - Stocks: delayed quotes (15min) or IEX real-time (free)
#   - Crypto: real-time
#   - Historical bars: unlimited
# Rate limit: ~200 requests/minute free tier
#
# Get keys: https://alpaca.markets → Paper Trading → API Keys
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_FEED=iex  # 'iex' (free) or 'sip' (paid real-time)

# ─── Polygon.io ──────────────────────────────────────────────
# Free tier supports: unlimited end-of-day data (stocks, ETFs, forex, crypto),
# 5+ years of historical EOD, 1 real-time call per minute, company profiles.
# Best free source for backtesting data (Q127-Q128).
#
# ⚠️ Declared ONCE. It was duplicated further down this file until 2026-09-26 — and in a template
# that gets copied to `.env`, a second `KEY=` silently wins or loses depending on the loader. The
# fix is one declaration, not two that happen to agree.
# Get key: https://polygon.io → Sign Up → API Keys
POLYGON_API_KEY=

# ─── Finnhub ─────────────────────────────────────────────────
# 60 calls/min free tier. Best free source for news sentiment
# and company fundamentals.
# Get key: https://finnhub.io/register (free, instant)
FINNHUB_API_KEY=

# ─── Twelve Data ─────────────────────────────────────────────
# 8 calls/min, 800 calls/day free tier.
# Get key: https://twelvedata.com (free, instant)
TWELVE_DATA_API_KEY=

# ─── Financial Modeling Prep ─────────────────────────────────
# 250 calls/day free tier. Best free source for company
# financials, earnings, and fundamentals.
# Get key: https://financialmodelingprep.com (free, instant)
FMP_API_KEY=

# ─── Notifications ───────────────────────────────────────────
# Email (SMTP)
NOTIFICATION_EMAIL_HOST=smtp.gmail.com
NOTIFICATION_EMAIL_PORT=587
NOTIFICATION_EMAIL_USER=your@gmail.com
NOTIFICATION_EMAIL_PASS=your_app_password
NOTIFICATION_EMAIL_TO=your@gmail.com
# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Discord Webhook
DISCORD_WEBHOOK_URL=

# ─── Alpha Vantage ───────────────────────────────────────────
ALPHA_VANTAGE_API_KEY=

# ─── Trading212 ──────────────────────────────────────────────
# Trading212 has LIVE and DEMO (paper) environments.
# Each environment uses a DIFFERENT API key and endpoint.
#
# TRADING212_MODE           'live' | 'demo' (default: 'demo' if any key is set)
# TRADING212_LIVE_API_KEY   API key for live (real-money) account
# TRADING212_DEMO_API_KEY   API key for demo (paper-trading) account
# TRADING212_API_KEY        Fallback key — used if the mode-specific key is empty
#
# ── Multi-Account Support ──────────────────────────────────
# If you have MULTIPLE live Trading212 accounts (e.g. Investment + Stocks ISA),
# use the account-specific keys below. The legacy keys above still work for
# single-account setups. If account-specific keys are set, they take priority.
#
# TRADING212_INVESTMENT_API_KEY   Investment account (multi-currency, non-ISA)
# TRADING212_INVESTMENT_API_SECRET
# TRADING212_ISA_API_KEY          Stocks ISA (GBP only, tax-free wrapper)
# TRADING212_ISA_API_SECRET
#
#
# Endpoints (defaults shown — rarely need to change):
# TRADING212_LIVE_BASE_URL  https://live.trading212.com/api/v0
# TRADING212_DEMO_BASE_URL  https://demo.trading212.com/api/v0
#
# Auth: API key passed as Authorization header (NOT Bearer prefix)
# Docs: https://t212public-api-docs.redoc.ly/
# Get keys: Trading212 app → Settings → API
#
TRADING212_MODE=demo
TRADING212_DEMO_API_KEY=
TRADING212_LIVE_API_KEY=
# TRADING212_API_KEY=         # legacy fallback — prefer mode-specific keys above
# TRADING212_DEMO_BASE_URL=   # default: https://demo.trading212.com/api/v0
# TRADING212_LIVE_BASE_URL=   # default: https://live.trading212.com/api/v0

# ─── AI Providers (Chat / Analysis) ──────────────────────────
# The AI controller (/api/lab/*) routes requests to a provider via the
# `provider` field: "deepseek" (default) or "gemini".
#
# DeepSeek — $0.14/M input, $0.28/M output. Get key: https://platform.deepseek.com/api_keys
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat            # deepseek-chat | deepseek-reasoner
#
# Gemini — free tier available via AI Studio (rate-limited).
# Get key: https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash           # gemini-3.6-flash | gemini-2.5-pro | gemini-2.0-flash

# ─── MetaTrader 5 (the primary broker) ───────────────────────
# The MT5 bridge runs as its own process (scripts/mt5-bridge/mt5_bridge_v2.py, port 5000)
# and holds the terminal connection for one or more accounts.
#
# MT5_ACTIVE_BROKERS   comma-separated ACCOUNT NUMBERS to bridge. Each gets its own bridge
#                      port (:5000, :5001, … in list order). Example: MT5_ACTIVE_BROKERS=2,3
#
# ⚠️ MT5_ASSET_BROKER_DEFAULTS WAS REMOVED 2026-09-25 (#1002) — it is now IGNORED if set.
#    It mapped an asset type to a broker ("index:3,forex:2") and RETURNED EARLY, before the
#    capability check added by #1002, so it could route a symbol to a broker whose own symbol
#    list refuses it (tradeMode = 0) — the exact failure #1002 fixes. It was also never
#    configured anywhere in the repo. Removing it satisfied criterion 4 of #1002 ("either set
#    or its dead path removed"): setting it would have introduced a routing preference nobody
#    asked for, and a preference that BYPASSES a guard is a trap, not an option.
#    Reversible: restore the map and its branch, placed AFTER the capability check.
