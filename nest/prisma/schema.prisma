model MarketSnapshot {
  id              String   @id @default(uuid()) @db.VarChar(36)
  symbol          String   @db.VarChar(20)
  timeframe        String   @db.VarChar(20)
  startTime       DateTime
  endTime         DateTime
  candleData      Json
  directiveScores Json?
  notes           String?  @db.Text
