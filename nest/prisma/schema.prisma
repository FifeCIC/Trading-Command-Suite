  weightStrategy  String   @default("group-weighted") @db.VarChar(20)
  gateConfig      Json?                                     // { groupId: { enabled, threshold } } — gate overrides per directive group
  enabled         Boolean  @default(true)
  tradingEnabled  Boolean  @default(false)
  activatedAt     DateTime?
  // Hot Stock Picks integration (#339) — mirror of TradingStrategy hotStock fields
  hotStockEnabled      Boolean  @default(false)
  hotStockAllocation   Float?   // separate allocation % for hot stock trades
  hotStockDetectionMode String? @db.VarChar(20) // "top-scoring" | "volume-spike" | "all"
  hotStockMaxHoldHours Int?     // shorter max hold for hot stock positions (default: 24h)
  // Position time-stop (#773) — mirror of TradingStrategy.maxHoldHours.
  // NULL = no limit. Kept in step so the settings surface and the enforcement path
  // cannot disagree about what a strategy allows.
  maxHoldHours  Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // FK relations deferred — dependent tables created separately (#470)
  // watchlist         Watchlist?               @relation(fields: [watchlistId], references: [id])
  // tradingStrategies TradingStrategy[]
  // protocolLinks     ScoringStrategyProtocol[]

  @@index([watchlistId])
  @@map("scoring_strategy")
}

