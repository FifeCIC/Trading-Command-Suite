// ── Stack Performance Rating ──────────────────────────────
// Tracks cumulative performance for each scoring strategy stack.
// Computed hourly/daily from Trade records, used for stack ratings.

model StackPerformance {
  id                String   @id @default(uuid()) @db.VarChar(36)
  scoringStrategyId String   @unique @db.VarChar(36)
  totalTrades       Int      @default(0)
  winningTrades     Int      @default(0)
  losingTrades      Int      @default(0)
  totalPnl          Float    @default(0)
  grossProfit       Float    @default(0)
  grossLoss         Float    @default(0)
  maxDrawdown       Float    @default(0)
  peakEquity        Float    @default(0)
  currentEquity     Float    @default(0)
  firstTradeAt      DateTime?
  lastTradeAt       DateTime?
  runtimeHours      Float    @default(0)
  effectivenessRate Float    @default(0)
  profitFactor      Float    @default(0)
  winRate           Float    @default(0)
  sharpeApprox      Float    @default(0)
  rating            Float    @default(0)
  fingerprint       String?  @db.VarChar(16)  // SHA-256 hash of MetaStack components at compute time
  computedAt        DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("stack_performance")
  @@index([scoringStrategyId])
  @@index([rating])
}

// ── Decision Log ─────────────────────────────────────────
// Persists automation loop decisions across restarts.
// One row per strategy evaluation per tick.

model DecisionLog {
  id          String   @id @default(uuid()) @db.VarChar(36)
  timestamp   DateTime @default(now())
  tickNumber  Int
  strategyId  String   @db.VarChar(36)
  symbol      String   @db.VarChar(20)
  decision    String   @db.VarChar(20)   // SCORED, SKIP, EXECUTED, FAILED, BLOCKED, QUEUED, HOLD
  reason      String?  @db.Text
  composite   Float    @default(0)
  signal      String?  @db.VarChar(10)    // BUY, SELL, HOLD
  ticket      Int?
  price       Float?
  quantity    Float?

  @@map("decision_log")
  @@index([timestamp])
  @@index([strategyId, timestamp])
  @@index([symbol, timestamp])
}

// ── Decision Trail ──────────────────────────────────────
// Captures the LONG vs SHORT protocol comparison that drives
// every trading decision. Currently computed in-memory and
// discarded after each tick (#350, #474).
//
// One row per strategy per tick — whether or not a trade executed.
// Links to score_snapshot (via timestamp+symbol+strategy) and
// trade (via tradeTicket) for full-chain traceability.

model DecisionTrail {
  id              String   @id @default(uuid()) @db.VarChar(36)
  tickNumber      Int
  timestamp       DateTime @default(now())
  strategyId      String   @db.VarChar(36)
  symbol          String   @db.VarChar(20)
  // LONG side
  longProtocolId  String?  @db.VarChar(100)
  longComposite   Float    @default(0)
  longSignal      String?  @db.VarChar(10)
  // SHORT side
  shortProtocolId String?  @db.VarChar(100)
  shortComposite  Float    @default(0)
  shortSignal     String?  @db.VarChar(10)
  // Outcome
  winner          String?  @db.VarChar(10)   // LONG | SHORT | NONE
  chosenComposite Float    @default(0)
  finalSignal     String?  @db.VarChar(10)   // BUY | SELL | HOLD
  reason          String?  @db.Text
  actionable      Boolean  @default(false)
  // Trade result (only if a trade executed)
  tradeTicket     Int?
  tradeVolume     Float?
  tradePrice      Float?

  // ── Chain linking (#475) — FK targets for joined audit queries ──
  // Populated progressively as the pipeline advances.
  // DB-level FKs are omitted due to MySQL engine mix; Prisma handles
  // joins at the application level via `include`.
  scoreSnapshotId String?  @db.VarChar(36)
  strategyEvalId  String?  @db.VarChar(36)
  tradeId         String?  @db.VarChar(36)

  @@map("decision_trail")
  @@index([timestamp])
  @@index([strategyId, tickNumber])
  @@index([symbol, timestamp])
  @@index([actionable])
  @@index([scoreSnapshotId])
  @@index([strategyEvalId])
  @@index([tradeId])
}

// ── Stop Adjustment (#476) ──────────────────────────────
// Tracks every SL/TP modification — whether by Stop Guardian
// automation or manual amend. Links back to the trade and
// records the directive scores that triggered the change.

model StopAdjustment {
  id              String   @id @default(uuid()) @db.VarChar(36)
  tradeTicket     Int
  symbol          String   @db.VarChar(20)
  oldSl           Float?
  newSl           Float?
  oldTp           Float?
  newTp           Float?
  reason          String   @db.VarChar(200)
  directiveScores Json?
  adjustedAt      DateTime @default(now())

  @@map("stop_adjustment")
  @@index([tradeTicket])
  @@index([symbol, adjustedAt])
}

// ── Audit trail ──────────────────────────────────────────
// Step-by-step trace of every decision point in the
// automation tick loop. Queryable for diagnostics.

model AutomationEvent {
  id          String   @id @default(uuid()) @db.VarChar(36)
  timestamp   DateTime @default(now())
  tickNumber  Int
  strategyId  String?  @db.VarChar(36)
  symbol      String?  @db.VarChar(20)
  step        String   @db.VarChar(60)   // e.g. 'tick_start', 'bars_fetched', 'scored', 'gated', 'dispatch', 'order_sent', 'order_result'
  decision    String?  @db.VarChar(20)    // BUY, SELL, HOLD, SKIP, EXECUTED, FAILED, BLOCKED
  detail      String?  @db.Text           // JSON payload with step-specific data
  durationMs  Int?

  @@map("automation_event")
  @@index([tickNumber])
  @@index([strategyId, tickNumber])
  @@index([symbol, timestamp])
  @@index([step, timestamp])
}

// ── Directive Audit Runs ─────────────────────────────────
// Trend storage for directive performance audits (#283).
// Each run captures the full classification snapshot.

model DirectiveAuditRun {
  id        String   @id @default(uuid()) @db.VarChar(36)
  symbol    String   @db.VarChar(20)
  days      Int
  topCount  Int
  refineCount Int
  stubCount Int
  noDataCount Int
  results   Json     // Full audit results JSON
  runAt     DateTime @default(now())

  @@map("directive_audit_run")
  @@index([symbol, runAt])
}

// ── Architecture Framework ───────────────────────────────
// DB-backed architecture knowledge base replacing the 600KB
// static .data.js file. Agents query via /api/architecture/*
// instead of reading the full file into context.

model ArchitectureSection {
  id          String   @id @default(uuid()) @db.VarChar(36)
  sectionKey  String   @unique @db.VarChar(50)
  title       String   @db.VarChar(200)
  description String?  @db.Text
  sortOrder   Int      @default(0)
  entries     ArchitectureEntry[]
  updatedAt   DateTime @updatedAt

  @@map("architecture_section")
}

model ArchitectureEntry {
  id          String   @id @default(uuid()) @db.VarChar(36)
  sectionId   String   @db.VarChar(36)
  section     ArchitectureSection @relation(fields: [sectionId], references: [id])
  sortOrder   Int      @default(0)
  content     String   @db.Text
  status      String   @default("active") @db.VarChar(20)
  tags        String?  @db.VarChar(500)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  revisions   ArchitectureRevision[]

  @@index([sectionId])
  @@index([status])
  @@map("architecture_entry")
}

model ArchitectureRevision {
  id              String   @id @default(uuid()) @db.VarChar(36)
  entryId         String   @db.VarChar(36)
  entry           ArchitectureEntry @relation(fields: [entryId], references: [id])
  previousContent String   @db.Text
  changedBy       String   @default("agent") @db.VarChar(20)
  changedAt       DateTime @default(now())

  @@index([entryId])
  @@map("architecture_revision")
}
model Capability {
  id                   String   @id @default(uuid()) @db.VarChar(36)
  name                 String   @db.VarChar(200)
  category             String   @default("General") @db.VarChar(100)
  area                 String   @default("Backend") @db.VarChar(100)
  type                 String   @default("Service") @db.VarChar(50)
  status               String   @default("ALPHA") @db.VarChar(30)
  notes                String?  @db.Text
  dataPersistence      String   @default("ephemeral") @db.VarChar(30)
  uiSurfaces           Int      @default(0)
  pipelineIntegration  String   @default("none") @db.VarChar(30)
  devCompletion        String   @default("partial") @db.VarChar(30)
  sortOrder            Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([category])
  @@index([area])
  @@map("capability")
}

// ─── Global Diversification ──────────────────────────────
// Cross-broker diversification settings and duplicate detection.
// Controls whether the app allows the same symbol across brokers,
// per-broker allocation percentages, and global exposure limits.

model GlobalSetting {
  key       String   @id @db.VarChar(100)
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("global_setting")
}

// ─── M.E.T.A. Protocol Registry ──────────────────────────
// DB-backed protocol definitions replacing the hardcoded
// PROTOCOL_REGISTRY in directive-groups.ts.
// Phase A.1 of META.Stack Architecture Refactor (#398).

// User research notes — free-text clippings (news, email, social, discord)
// with ticker detection on the frontend. Research area review (2026-08-22).
model ResearchNote {
  id        String   @id @default(uuid()) @db.VarChar(36)
  content   String   @db.Text
  sortOrder Int      @default(0)
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt

  @@map("research_note")
}

model Protocol {
  id                   String   @id @default(uuid()) @db.VarChar(36)
  slug                 String   @unique @db.VarChar(100)
  name                 String   @db.VarChar(200)
  description          String?  @db.Text
  active               Boolean  @default(true)
  version              String   @default("1.0.0") @db.VarChar(20)  // Semver for A/B tracking (#295)
  directionMode        String   @default("LONG_ONLY") @db.VarChar(20)
  tradingStyle         String?  @db.VarChar(50)
  recommendedTimeframe String?  @db.VarChar(20)
  avgHoldTime          String?  @db.VarChar(50)
  winRateTarget        String?  @db.VarChar(20)
  idealFor             String?  @db.Text
  note                 String?  @db.Text  // Human-readable state explanation (e.g. why disabled)
  theory               String?  @db.Text  // #689 — written intent: target behaviour, why these groups, what a good day looks like
  derivedFrom          String?  @db.VarChar(100)  // Parent protocol slug — links variants for A/B testing
  isDefault            Boolean  @default(false)
  seasonalAffinity     Json?                                      // monthly weights + date ranges
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  directiveGroups      ProtocolDirectiveGroup[]
  symbolAssignments    SymbolProtocolAssignment[]

  @@map("protocol")
  @@index([slug])
  @@index([directionMode])
}

// Loop-owned runtime state explaining WHY a protocol is or isn't scoring.
// States: scoring | no-symbols | no-data | paused | error. Row absent = pending.
model ProtocolScoreStatus {
  protocolId      String    @id @db.VarChar(100)
  state           String    @db.VarChar(30)
  reason          String?   @db.Text
  symbolsResolved Int       @default(0)
  symbolsScored   Int       @default(0)
  lastTickAt      DateTime? @db.DateTime(3)
  updatedAt       DateTime  @default(now()) @updatedAt @db.DateTime(3)

  @@map("protocol_score_status")
  @@index([state])
}

model ProtocolDirectiveGroup {
  id            String   @id @default(uuid()) @db.VarChar(36)
  protocolId    String   @db.VarChar(36)
  groupId       String   @db.VarChar(50)   // 'technical' | 'sentiment' | 'risk' | 'bearish-technical' etc.
  name          String   @db.VarChar(200)
  description   String?  @db.Text
  weight        Float    @default(1.0)     // coefficient in composite formula
  isRiskGate    Boolean  @default(false)   // multiplicative gate?
  minMultiplier Float    @default(0.3)
  maxMultiplier Float    @default(1.2)
  sortOrder     Int      @default(0)

  protocol      Protocol                    @relation(fields: [protocolId], references: [id], onDelete: Cascade)
  directives    ProtocolDirectiveEntry[]

  @@unique([protocolId, groupId])
  @@map("protocol_directive_group")
}

model ProtocolDirectiveEntry {
  id           String   @id @default(uuid()) @db.VarChar(36)
  groupId      String   @db.VarChar(36)
  directiveId  String   @db.VarChar(100)  // matches directive registry ID
  maxScore     Int      @default(100)     // per-directive maxScore override
  active       Boolean  @default(true)    // toggle on/off from Configure Directives page

  group        ProtocolDirectiveGroup      @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, directiveId])
  @@map("protocol_directive_entry")
}

// Symbol ↔ Protocol assignment for speed scanner and auto-matching.
// Replaces the hardcoded SYMBOL_PROTOCOL_MAP in speed-scan.service.ts.
model SymbolProtocolAssignment {
  id          String   @id @default(uuid()) @db.VarChar(36)
  symbol      String   @db.VarChar(20)
  protocolId  String   @db.VarChar(36)
  priority    Int      @default(0)          // lower = higher priority

  protocol    Protocol @relation(fields: [protocolId], references: [id], onDelete: Cascade)

  @@unique([symbol, protocolId])
  @@index([symbol])
  @@map("symbol_protocol_assignment")
}

// ── Pending Actions (#352) ────────────────────────────────
// Persists semi-auto queued trades across NestJS restarts.

model PendingAction {
  id          String   @id @db.VarChar(36)
  strategyId  String   @db.VarChar(36)
  symbol      String   @db.VarChar(20)
  brokerId    String   @db.VarChar(50)
  side        String   @db.VarChar(10)
  quantity    Float
  composite   Float
  createdAt   DateTime
  expiresAt   DateTime
  status      String   @default("pending") @db.VarChar(20)

  @@map("pending_action")
  @@index([strategyId])
  @@index([status])
}

model Alert {
  id           String    @id @default(uuid()) @db.VarChar(36)
  type         String    @db.VarChar(50)    // signal | drawdown | daily | backtest | system
  title        String    @db.VarChar(200)
  detail       String?   @db.Text
  severity     String    @default("info") @db.VarChar(20)  // critical | warning | info | success
  ticker       String?   @db.VarChar(20)  // optional linked symbol
  link         String?   @db.VarChar(500) // optional navigation URL
  acknowledged Boolean   @default(false)
  dismissed    Boolean   @default(false)
  snoozedUntil DateTime?
  createdAt    DateTime  @default(now())
  readAt       DateTime?

  @@index([type, createdAt])
  @@index([acknowledged, createdAt])
}

// ── Broker Configuration (#589 Phase 1) ──
// Persisted broker capabilities replacing the in-memory PROTOCOL_BROKER_MAP.
model BrokerConfig {
  id                 String   @id @db.VarChar(50)  // brokerId: "mt5", "trading212", "paper", "capital.com"
  displayName        String   @db.VarChar(100)
  supportedStyles    Json                        // ["scalp","day-trade","swing","position","speed"]
  supportedAssetTypes Json                       // ["forex","commodity","index","crypto","stock","etf"]
  tradingEnabled     Boolean  @default(false)
  note               String?  @db.Text
  isActive           Boolean  @default(true)     // admin on/off for this broker
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("broker_config")
}

// Unified Job Queue (#614 Phase 0) — DB-driven job table the automation loop polls.
model ScheduledJob {
  id           String    @id @default(uuid()) @db.VarChar(36)
  type         String    @db.VarChar(50) // 'score-protocol' | 'import-data' | 'execute-trade' | 'fetch-bars'
  status       String    @default("queued") @db.VarChar(20) // queued | running | complete | failed | cancelled
  priority     Int       @default(50) // 0-100, higher runs first
  runAt        DateTime  @default(now()) // next time this job is due
  recurrence   String?   @db.VarChar(20) // null = one-time | 'interval' | 'cron'
  recurrenceMs Int? // for 'interval' — ms between runs (permanent jobs)
  payload      Json? // job-specific data (symbol, protocolId, etc.)
  attempts     Int       @default(0)
  maxAttempts  Int       @default(3)
  lastRunAt    DateTime?
  lastError    String?   @db.Text
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, runAt])
  @@index([type])
  @@map("scheduled_job")
}

// A/B Test Runner (#482) — run two MetaStack snapshots side-by-side.
model AbTest {
  id             String    @id @default(uuid()) @db.VarChar(36)
  name           String    @db.VarChar(200)
  controlStackId String    @db.VarChar(36) // MetaStackSnapshot id (side A)
  variantStackId String    @db.VarChar(36) // MetaStackSnapshot id (side B)
  symbols        Json                       // string[] (max 4)
  startAt        DateTime?
  endAt          DateTime?
  status         String    @default("draft") @db.VarChar(20) // draft | running | complete | cancelled
  results        Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
  @@map("ab_test")
}

// Signal Dismissal (#684) — Signals v1: hide a signal for N hours.
// Keyed on symbol+protocol so dismissals survive reloads and re-scoring.
model SignalDismissal {
  id             String   @id @default(uuid()) @db.VarChar(36)
  symbol         String   @db.VarChar(20)
  protocolId     String   @db.VarChar(50) // 'any' when no protocol specified
  dismissedUntil DateTime
  createdAt      DateTime @default(now())

  @@unique([symbol, protocolId])
  @@index([dismissedUntil])
  @@map("signal_dismissal")
}
