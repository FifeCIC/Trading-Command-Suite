// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Symbol {
  id        String   @id @default(uuid()) @db.VarChar(36)
  ticker    String   @unique @db.VarChar(20)
  name      String   @db.VarChar(200)
  exchange  String   @db.VarChar(50)
  type      String   @db.VarChar(50)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scores     Score[]
  signals    Signal[]
  marketBars MarketBar[]
  importRuns ImportRun[]
}

model Strategy {
  id          String   @id @default(uuid()) @db.VarChar(36)
  name        String   @db.VarChar(200)
  description String?  @db.Text
  config      Json
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  directives Directive[]
  scores     Score[]
  signals    Signal[]
}

model Directive {
  id         String   @id @default(uuid()) @db.VarChar(36)
  strategyId String   @db.VarChar(36)
  name       String   @db.VarChar(200)
  type       String   @db.VarChar(50)
  weight     Float
  config     Json
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  strategy Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  @@index([strategyId])
}

model Score {
  id         String   @id @default(uuid()) @db.VarChar(36)
  symbolId   String   @db.VarChar(36)
  strategyId String   @db.VarChar(36)
  value      Float
  breakdown  Json
  timestamp  DateTime @default(now())

  symbol   Symbol   @relation(fields: [symbolId], references: [id], onDelete: Cascade)
  strategy Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  @@index([symbolId, timestamp])
  @@index([strategyId, timestamp])
}

model Signal {
  id         String   @id @default(uuid()) @db.VarChar(36)
  symbolId   String   @db.VarChar(36)
  strategyId String   @db.VarChar(36)
  type       String   @db.VarChar(50)
  strength   Float
  price      Float
  reason     Json
  status     String   @db.VarChar(50)
  createdAt  DateTime @default(now())

  symbol   Symbol   @relation(fields: [symbolId], references: [id], onDelete: Cascade)
  strategy Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  @@index([symbolId, createdAt])
  @@index([strategyId, createdAt])
}

model MarketBar {
  id         String   @id @default(uuid()) @db.VarChar(36)
  symbolId   String   @db.VarChar(36)
  provider   String   @db.VarChar(50)
  timeframe  String   @db.VarChar(20)
  timestamp  DateTime
  open       Float
  high       Float
  low        Float
  close      Float
  volume     Float
  importedAt DateTime @default(now())

  symbol Symbol @relation(fields: [symbolId], references: [id], onDelete: Cascade)

  @@index([symbolId, timeframe, timestamp])
  @@index([provider, importedAt])
}

model ImportRun {
  id          String    @id @default(uuid()) @db.VarChar(36)
  symbolId    String    @db.VarChar(36)
  provider    String    @db.VarChar(50)
  timeframe   String    @db.VarChar(20)
  status      String    @db.VarChar(50)
  source      String    @db.VarChar(100)
  requestedAt DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  error       String?   @db.Text

  symbol Symbol @relation(fields: [symbolId], references: [id], onDelete: Cascade)

  @@index([symbolId, requestedAt])
  @@index([status, requestedAt])
}

model ProviderHealth {
  id            String   @id @default(uuid()) @db.VarChar(36)
  provider      String   @unique @db.VarChar(50)
  status        String   @db.VarChar(50)
  message       String?  @db.Text
  latencyMs     Int?
  checkedAt     DateTime @default(now())
  credentialsOk Boolean  @default(false)
  endpoint      String?  @db.VarChar(500)

  @@index([status, checkedAt])
}

model FaqEntry {
  id        String   @id @default(uuid()) @db.VarChar(36)
  question  String   @db.Text
  answer    String   @db.Text
  category  String   @db.VarChar(100)
  tags      String   @db.VarChar(500)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, order])
  @@index([category])
}
