  pnl         Float?
  provider    String   @db.VarChar(50)
  accountId   String?  @db.VarChar(100)
  lastQuotedAt DateTime?
  openedAt    DateTime @default(now())
  updatedAt   DateTime @updatedAt
  // Broker traceability (#616) — the 64-bit broker ticket is a STRING.
  // MT5 position tickets exceed the 32-bit Int range, so we store them here
  // as text and never rely on the legacy Int column for MT5.
  brokerTicket String?  @db.VarChar(100)
  side         String?  @db.VarChar(10)  // buy | sell
  magic        Int?

  @@index([symbol])
  @@index([symbolId])
  @@index([provider, accountId])
  @@index([brokerTicket])
  @@unique([provider, brokerTicket])
}

model Trade {
  id                String   @id @default(uuid()) @db.VarChar(36)
  symbol            String   @db.VarChar(20)
  side              String   @db.VarChar(10)
  quantity          Float
  entryPrice        Float
  exitPrice         Float?
  pnl               Float?
  status            String   @default("open") @db.VarChar(50)
  provider          String   @db.VarChar(50)
  /// WHICH BROKER ACCOUNT this trade belongs to (#889).
  ///
  /// One `provider` id can cover several bridge instances — `MT5_ACTIVE_BROKERS=2,3` runs
  /// MetaQuotes and Pepperstone under the single provider `mt5`. Without this column the
  /// reconciler could not tell which broker a trade belonged to, so an account-scoped sync
  /// closed another account's LIVE trades (measured 2026-09-18, #883).
  ///
  /// ⚠️ NULL means "broker unknown" — legacy rows written before this column existed, and
  /// historical closed trades whose `position` row is long gone. A NULL row must NEVER be
  /// closed by an account-scoped sync; only an all-account snapshot may judge it.
  accountId         String?  @db.VarChar(100)
  strategy          String?  @db.VarChar(200)
  scoringStrategyId String?  @db.VarChar(36)
  origin            String   @default("user") @db.VarChar(20)
  source            String?  @db.VarChar(30)  // Pipeline: meta-stack | speed-scanner | manual | backtest | directive-direct
  abTestId          String?  @db.VarChar(36)  // A/B test pairing reference
  /// WHICH SIDE of an A/B test this trade belongs to — `'A'` (control) or `'B'` (variant).
  ///
  /// ⚠️ Added 2026-09-23 (#929). `computeResults` used to attribute a side by PARSING
  /// `brokerComment` for the `AB-A` / `AB-B` tag. That string is not immutable: the
  /// stranded-trade reaper (`position-sync.service.ts`) OVERWRITES it with
  /// `'Reconciled: no broker counterpart (stranded row)'`, so any reaped A/B trade silently
  /// lost its side and VANISHED from the verdict — measured 2026-09-23: 14 of 14 A/B rows
  /// had `brokerComment` rewritten and attributed 0 to each side.
  ///
  /// A verdict must not depend on a mutable display string. This column is the attribution.
  /// NULL means "not an A/B trade" (or a row written before this column existed).
  abTestSide        String?  @db.VarChar(1)
  openedAt          DateTime @default(now())
  closedAt          DateTime?
  createdAt         DateTime @default(now())
  // Broker traceability (#446, #470) — broker-agnostic
  /// ⚠️ BIGINT since 2026-09-22 — was `int`. A real MT5 ticket is 12 digits
  /// (e.g. 152668901120), which does NOT fit in int32. MySQL runs non-strict here
  /// (`sql_mode` is empty), so every out-of-range write was **silently clamped to
  /// 2147483647** instead of erroring. 15 rows were lost this way and are NOT recoverable:
  /// their `brokerTicket` is null, so the original value is gone. Contrast `brokerTicket`
  /// (VARCHAR(100)), which was always correct — prefer it when both are present.
  ticket           BigInt?  // Legacy MT5 ticket (kept for existing data)
  brokerTicket     String?  @db.VarChar(100) // Broker-specific order/position ID (MT5 ticket, T212 orderId, etc.)
  sl                Float?   // Stop-loss price
  tp                Float?   // Take-profit price
  magic             Int?     // MT5 magic number
  swap              Float?   // Accumulated swap
  /// #777 cost model — persisted from the CLOSING DEALS at finalise time. NULL means "not captured
  /// for this row" (closed before 2026-09-22), NEVER zero: a 0 would claim the broker charged
  /// nothing, which is the fabrication class these columns exist to end. `grossPnl` in the
  /// per-protocol view is computed only over rows that carry these values.
  commission        Float?
  fee               Float?
  brokerComment     String?  @db.VarChar(200) // MT5 position comment

  // ── WHY this trade closed ─────────────────────────────────────────────────
  // ⚠️ Added 2026-09-18 after a measurement that could not be explained without it.
  //
  // Measured 2026-09-18: 15 of 16 bot trades closed at **3–18% of the distance** to their
  // configured SL/TP — AUDJPY had a 1.003% stop and closed at 0.036% — and three positions
  // closed inside FIVE SECONDS (NZDJPY 12:15:59, EURGBP 12:16:00, EURCHF 12:16:04). A batch,
  // not the market. Nothing in the system could name the closer:
  //   - the time-stop keeps its close history IN MEMORY, so it is wiped on every restart;
  //   - every closing deal in MT5 history has an EMPTY `comment` (openings carry `TCS <bot>`),
  //     so the broker did not tag it as an SL/TP fill either.
  // An hour of elimination produced suspects but no cause. This column is that record.
  //
  // Format is `<authority>:<mechanism>` so a reader can separate WHO from WHY:
  //   system:time-stop     the #773 position time-stop closed it
  //   system:reconciled    the sync found no broker counterpart (stranded row)
  //   user:manual          closed through the API/UI
  //   broker:sl | broker:tp  MT5 closed at the stop / target (needs the deal `reason`)
  //   broker:stop-out      MT5 margin stop-out
  //   broker:unknown       the position vanished from the broker, cause not reported
  //
  // ⚠️ `broker:*` values depend on the bridge returning the deal `reason` field, which it does
  // NOT yet (see scripts/mt5-bridge/mt5_bridge_v2.py — the field is added but the running bridge
  // is an older build). Until it is redeployed those closes record `broker:unknown`, which is
  // honest: it says "the broker did it and did not say why" rather than guessing.
  closeReason       String?  @db.VarChar(60)

  // ── Signal age at execution (#882) ───────────────────────────────────────
  // ⚠️ FRESHNESS, not waiting time: minutes between the queue entry's LAST CONFIRMATION
  // (`strategy_signal_queue.updatedAt`) and the moment it became an order. Writer:
  // AutomationLoopService.processSignalQueues, best-effort UPDATE by provider+brokerTicket.
  // NULL on every path that does not come from strategy_signal_queue (manual, paper,
  // backtest) — absence, not a zero. WHY: a 120-hour-old queue entry executed on 2026-09-21
  // and an order was placed on a 20.6-hour-old score, and NOTHING recorded how stale a
  // signal was at execution — it was discoverable only by a bespoke reconstruction.
  signalAgeAtExecutionMinutes Int?

  // ── P&L validity (bridge bug, pre-2026-09-10) ────────────────────────────
  // ⚠️ These four columns EXISTED IN THE DATABASE but were MISSING FROM THIS MODEL until
  // 2026-09-12, so Prisma could neither read nor write them. That omission is how a
  // measurement tool came to report an 8.77% win rate over 114 trades when 82 of those
  // rows were unusable placeholders — it could not see `pnlInvalid`, so it counted them.
  // Adding a field to a model does NOT alter the database; see database-schema.instructions.md.
  //
  //   pnlInvalid      1 = the exit price was never captured, so `pnl` is a placeholder 0,
  //                      NOT a break-even trade. ALWAYS exclude these from any P&L stat.
  //   pnlInvalidReason why it was flagged (records the specific bridge defect)
  //   pnlRaw /         the values as received from the bridge before validity checks, kept
  //   exitPriceRaw     for diagnosis. Do NOT treat as usable P&L — see #805.
  pnlInvalid        Int?     @default(0)
  pnlInvalidReason  String?  @db.Text
  pnlRaw            Float?
  exitPriceRaw      Float?

  @@index([symbol, openedAt])
  @@index([status])
  @@index([origin, createdAt])
  @@index([scoringStrategyId])
  @@index([brokerTicket])
  @@unique([provider, brokerTicket])
}

