  @@index([symbol, fetchedAt])
  @@index([fetchedAt])
}

// ── Stack Performance Rating ──────────────────────────────
// Tracks cumulative performance for each scoring strategy stack.
// Computed hourly/daily from Trade records, used for stack ratings.

model StackPerformance {
  id                String   @id @default(uuid()) @db.VarChar(36)
  scoringStrategyId String   @unique @db.VarChar(36)
  totalTrades       Int      @default(0)
  winningTrades     Int      @default(0)
  losingTrades      Int      @default(0)
  totalPnl          Float    @default(0)
  grossProfit       Float    @default(0)
  grossLoss         Float    @default(0)
  maxDrawdown       Float    @default(0)
  peakEquity        Float    @default(0)
  currentEquity     Float    @default(0)
  firstTradeAt      DateTime?
  lastTradeAt       DateTime?
  runtimeHours      Float    @default(0)
  effectivenessRate Float    @default(0)
  profitFactor      Float    @default(0)
  winRate           Float    @default(0)
  sharpeApprox      Float    @default(0)
  rating            Float    @default(0)
  fingerprint       String?  @db.VarChar(16)  // SHA-256 hash of MetaStack components at compute time
  computedAt        DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("stack_performance")
  @@index([scoringStrategyId])
  @@index([rating])
}

// ── Decision Log ─────────────────────────────────────────
// Persists automation loop decisions across restarts.
// One row per strategy evaluation per tick.

model DecisionLog {
  id          String   @id @default(uuid()) @db.VarChar(36)
  timestamp   DateTime @default(now())
  tickNumber  Int
  strategyId  String   @db.VarChar(36)
  symbol      String   @db.VarChar(20)
  decision    String   @db.VarChar(20)   // SCORED, SKIP, EXECUTED, FAILED, BLOCKED, QUEUED, HOLD
  reason      String?  @db.Text
  composite   Float    @default(0)
  signal      String?  @db.VarChar(10)    // BUY, SELL, HOLD
  ticket      Int?
  price       Float?
  quantity    Float?

  @@map("decision_log")
  @@index([timestamp])
  @@index([strategyId, timestamp])
  @@index([symbol, timestamp])
}

// ── Audit trail ──────────────────────────────────────────
// Step-by-step trace of every decision point in the
// automation tick loop. Queryable for diagnostics.

model AutomationEvent {
  id          String   @id @default(uuid()) @db.VarChar(36)
  timestamp   DateTime @default(now())
  tickNumber  Int
  strategyId  String?  @db.VarChar(36)
  symbol      String?  @db.VarChar(20)
  step        String   @db.VarChar(60)   // e.g. 'tick_start', 'bars_fetched', 'scored', 'gated', 'dispatch', 'order_sent', 'order_result'
  decision    String?  @db.VarChar(20)    // BUY, SELL, HOLD, SKIP, EXECUTED, FAILED, BLOCKED
  detail      String?  @db.Text           // JSON payload with step-specific data
  durationMs  Int?

  @@map("automation_event")
  @@index([tickNumber])
  @@index([strategyId, tickNumber])
  @@index([symbol, timestamp])
  @@index([step, timestamp])
}

// ── Architecture Framework ───────────────────────────────
// DB-backed architecture knowledge base replacing the 600KB
// static .data.js file. Agents query via /api/architecture/*
// instead of reading the full file into context.

model ArchitectureSection {
  id          String   @id @default(uuid()) @db.VarChar(36)
  sectionKey  String   @unique @db.VarChar(50)
  title       String   @db.VarChar(200)
  description String?  @db.Text
  sortOrder   Int      @default(0)
  entries     ArchitectureEntry[]
  updatedAt   DateTime @updatedAt

  @@map("architecture_section")
}

model ArchitectureEntry {
  id          String   @id @default(uuid()) @db.VarChar(36)
  sectionId   String   @db.VarChar(36)
  section     ArchitectureSection @relation(fields: [sectionId], references: [id])
  sortOrder   Int      @default(0)
  content     String   @db.Text
  status      String   @default("active") @db.VarChar(20)
  tags        String?  @db.VarChar(500)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  revisions   ArchitectureRevision[]

  @@index([sectionId])
  @@index([status])
  @@map("architecture_entry")
}

model ArchitectureRevision {
  id              String   @id @default(uuid()) @db.VarChar(36)
  entryId         String   @db.VarChar(36)
  entry           ArchitectureEntry @relation(fields: [entryId], references: [id])
  previousContent String   @db.Text
  changedBy       String   @default("agent") @db.VarChar(20)
  changedAt       DateTime @default(now())

  @@index([entryId])
  @@map("architecture_revision")
}
model Capability {
