model ScoringStrategy {
  id              String   @id @default(uuid()) @db.VarChar(36)
  name            String   @db.VarChar(200)
  version         String   @default("1.0.0") @db.VarChar(20)  // Semver for A/B tracking (#295)
  protocolId      String   @db.VarChar(100)
  shortProtocolId String?  @db.VarChar(100)
  watchlistName   String   @db.VarChar(100)
  watchlistId     String?  @db.VarChar(36)  // Phase A.3: FK to Watchlist — nullable during transition
  brokerId        String   @default("mt5") @db.VarChar(50)
  mode            String   @default("manual") @db.VarChar(20)
  // ⚠️ 60 -> 10 (2026-09-15, #839). Pre-rescale value; nothing on the new scale (~10-33) can
  // clear it. See TradingStrategy.minComposite above for the full reasoning.
  // ⚠️ NOTE: this column is NOT gated on any more (the scoring_strategy layer was retired from
  // the trading loop 2026-08-27) — but it IS read for display, where an unclearable value
  // renders a false "FAIL". The 25 legacy rows still holding 50/55/60 were NOT rewritten.
  tradeThreshold  Float    @default(10)
  baseSize        Float    @default(0.01)
  slPct           Float    @default(1.0)
  tpPct           Float    @default(1.0)
  maxPyramidTiers Int      @default(1)
