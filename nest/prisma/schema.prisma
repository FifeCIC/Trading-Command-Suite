// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Symbol {
  id        String   @id @default(uuid())
  ticker    String   @unique
  name      String
  exchange  String
  type      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scores     Score[]
  signals    Signal[]
  marketBars MarketBar[]
  importRuns ImportRun[]
}

model Strategy {
  id          String   @id @default(uuid())
  name        String
  description String?
  config      Json
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  directives Directive[]
  scores     Score[]
  signals    Signal[]
}

model Directive {
  id         String   @id @default(uuid())
  strategyId String
  name       String
  type       String
  weight     Float
  config     Json
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  strategy Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  @@index([strategyId])
}

model Score {
  id        String   @id @default(uuid())
  symbolId  String
  strategyId String
  value     Float
  breakdown Json
  timestamp DateTime @default(now())

  symbol   Symbol   @relation(fields: [symbolId], references: [id], onDelete: Cascade)
  strategy Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  @@index([symbolId, timestamp])
  @@index([strategyId, timestamp])
}

model Signal {
  id         String   @id @default(uuid())
  symbolId   String
  strategyId String
  type       String
  strength   Float
  price      Float
  reason     Json
  status     String
  createdAt  DateTime @default(now())

  symbol   Symbol   @relation(fields: [symbolId], references: [id], onDelete: Cascade)
  strategy Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  @@index([symbolId, createdAt])
  @@index([strategyId, createdAt])
}

model MarketBar {
  id         String   @id @default(uuid())
  symbolId   String
  provider   String
  timeframe  String
  timestamp  DateTime
  open       Float
  high       Float
  low        Float
  close      Float
  volume     Float
  importedAt DateTime @default(now())

  symbol Symbol @relation(fields: [symbolId], references: [id], onDelete: Cascade)

  @@index([symbolId, timeframe, timestamp])
  @@index([provider, importedAt])
}

model ImportRun {
  id          String    @id @default(uuid())
  symbolId    String
  provider    String
  timeframe   String
  status      String
  source      String
  requestedAt DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  error       String?

  symbol Symbol @relation(fields: [symbolId], references: [id], onDelete: Cascade)

  @@index([symbolId, requestedAt])
  @@index([status, requestedAt])
}

model ProviderHealth {
  id            String   @id @default(uuid())
  provider      String   @unique
  status        String
  message       String?
  latencyMs     Int?
  checkedAt     DateTime @default(now())
  credentialsOk Boolean  @default(false)
  endpoint      String?

  @@index([status, checkedAt])
}
