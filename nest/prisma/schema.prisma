model GlobalSetting {
  key       String   @id @db.VarChar(100)
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("global_setting")
}

// ─── META.Stack Protocol Registry ──────────────────────────
// DB-backed protocol definitions replacing the hardcoded
// PROTOCOL_REGISTRY in directive-groups.ts.
// Phase A.1 of META.Stack Architecture Refactor (#398).

// User research notes — free-text clippings (news, email, social, discord)
// with ticker detection on the frontend. Research area review (2026-08-22).
model ResearchNote {
  id        String   @id @default(uuid()) @db.VarChar(36)
  content   String   @db.Text
  sortOrder Int      @default(0)
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt

  @@map("research_note")
}

model Protocol {
  id                   String   @id @default(uuid()) @db.VarChar(36)
  slug                 String   @unique @db.VarChar(100)
  name                 String   @db.VarChar(200)
  description          String?  @db.Text
  active               Boolean  @default(true)
  version              String   @default("1.0.0") @db.VarChar(20)  // Semver for A/B tracking (#295)
  directionMode        String   @default("LONG_ONLY") @db.VarChar(20)
  tradingStyle         String?  @db.VarChar(50)
  recommendedTimeframe String?  @db.VarChar(20)
  avgHoldTime          String?  @db.VarChar(50)
  winRateTarget        String?  @db.VarChar(20)
  idealFor             String?  @db.Text
  note                 String?  @db.Text  // Human-readable state explanation (e.g. why disabled)
  theory               String?  @db.Text  // #689 — written intent: target behaviour, why these groups, what a good day looks like
  derivedFrom          String?  @db.VarChar(100)  // Parent protocol slug — links variants for A/B testing
  isDefault            Boolean  @default(false)
  seasonalAffinity     Json?                                      // monthly weights + date ranges
  highestScore         Float?                                     // #600 — peak composite ever recorded (survives Score pruning)
  // ── Adaptive Target (2026-09-10) — "realistic ceiling" ──
  // OFF by default. See docs/scoring-architecture.md and the central docs store's handoff/2026-09-10-adaptive-target.md.
  //
  // WHY: a protocol's structural ceiling is usually far below its configured capacity,
  // because directives are mutually exclusive — they cannot all fire on one bar
  // (#685, PROTOCOL-THEORY.md: xau-speed-v1 "Ceiling ~77% is by design"). Measuring
  // `raw / configuredSignalMax` therefore undersells a genuine reading. When enabled,
  // the percentage divides by `adaptiveTargetMax` — the protocol's own observed peak —
  // so the number answers "is this good FOR THIS PROTOCOL".
  //
  // ⚠️ MONOTONIC BY DESIGN — this value only ever INCREASES. It must never be lowered
  // on a rolling window: a falling target silently re-baselines a protocol and masks a
  // directive that has stopped working, which is the "plausible numbers with no error"
  // failure class this repo has hit repeatedly. A quiet month must NOT lower the bar.
  adaptiveTargetEnabled Boolean @default(false)                   // opt-in per protocol
  adaptiveTargetMax     Float?                                    // observed peak RAW composite (pre-gate, so gating can't shrink it)
  adaptiveTargetSamples Int     @default(0)                       // readings contributing to the peak
  adaptiveTargetSince   DateTime?                                 // when the peak was first set (for "since <date>" copy)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  directiveGroups      ProtocolDirectiveGroup[]
  symbolAssignments    SymbolProtocolAssignment[]

  @@map("protocol")
  @@index([slug])
  @@index([directionMode])
}

// Loop-owned runtime state explaining WHY a protocol is or isn't scoring.
// States: scoring | no-symbols | no-data | paused | error. Row absent = pending.
model ProtocolScoreStatus {
  protocolId      String    @id @db.VarChar(100)
  state           String    @db.VarChar(30)
  reason          String?   @db.Text
  symbolsResolved Int       @default(0)
  symbolsScored   Int       @default(0)
  lastTickAt      DateTime? @db.DateTime(3)
  updatedAt       DateTime  @default(now()) @updatedAt @db.DateTime(3)

  @@map("protocol_score_status")
  @@index([state])
}

model ProtocolDirectiveGroup {
  id            String   @id @default(uuid()) @db.VarChar(36)
  protocolId    String   @db.VarChar(36)
  groupId       String   @db.VarChar(50)   // 'technical' | 'sentiment' | 'risk' | 'bearish-technical' etc.
  name          String   @db.VarChar(200)
  description   String?  @db.Text
  weight        Float    @default(1.0)     // coefficient in composite formula
  isRiskGate    Boolean  @default(false)   // multiplicative gate?
  minMultiplier Float    @default(0.3)
  maxMultiplier Float    @default(1.2)
  sortOrder     Int      @default(0)

  protocol      Protocol                    @relation(fields: [protocolId], references: [id], onDelete: Cascade)
  directives    ProtocolDirectiveEntry[]

  @@unique([protocolId, groupId])
  @@map("protocol_directive_group")
}

model ProtocolDirectiveEntry {
  id           String   @id @default(uuid()) @db.VarChar(36)
  groupId      String   @db.VarChar(36)
  directiveId  String   @db.VarChar(100)  // matches directive registry ID
  maxScore     Int      @default(100)     // per-directive maxScore override
  active       Boolean  @default(true)    // toggle on/off from Configure Directives page

  group        ProtocolDirectiveGroup      @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, directiveId])
  @@map("protocol_directive_entry")
}

// Symbol ↔ Protocol assignment for speed scanner and auto-matching.
// Replaces the hardcoded SYMBOL_PROTOCOL_MAP in speed-scan.service.ts.
model SymbolProtocolAssignment {
  id          String   @id @default(uuid()) @db.VarChar(36)
  symbol      String   @db.VarChar(20)
  protocolId  String   @db.VarChar(36)
  priority    Int      @default(0)          // lower = higher priority

  protocol    Protocol @relation(fields: [protocolId], references: [id], onDelete: Cascade)

  @@unique([symbol, protocolId])
  @@index([symbol])
  @@map("symbol_protocol_assignment")
}

// Per-symbol MT5 broker routing (GH #747) — which bridge instance serves a symbol,
// plus the optional broker-native symbol name. Source of truth for Mt5SymbolRouter,
// which caches it in memory for O(1) per-tick resolution. brokerId = MT5 account
// slot (2 = MetaQuotes :5000, 3 = Pepperstone :5001, …).
model SymbolRoute {
  id           String   @id @default(uuid()) @db.VarChar(36)
  symbol       String   @db.VarChar(20)          // canonical ticker (Symbol.ticker)
  brokerId     Int                                // MT5 account slot (or 0 for non-MT5)
  brokerSymbol String?  @db.VarChar(50)           // broker-native name (e.g. UK100-F)
  // ⚠️ provider WAS MISSING FROM THIS MODEL until 2026-09-11, while the column
  // existed in the database. Prisma therefore could not read or write it, so the
  // binance crypto routes (brokerId 0) lost their distinguishing field on any
  // code path that round-tripped through Prisma. Discovered while seeding VIX.
  // The DB is authoritative here: `prisma db pull` reports this column.
  provider     String   @default("mt5") @db.VarChar(32)
  priority     Int      @default(0)               // lower = preferred when several
  enabled      Boolean  @default(true)
  note         String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([symbol, brokerId])
  @@index([brokerId])
  @@index([symbol])
  @@map("symbol_route")
}

// ── Pending Actions (#352) ────────────────────────────────
// Persists semi-auto queued trades across NestJS restarts.

model PendingAction {
  id          String   @id @db.VarChar(36)
  strategyId  String   @db.VarChar(36)
  symbol      String   @db.VarChar(20)
  brokerId    String   @db.VarChar(50)
  side        String   @db.VarChar(10)
  quantity    Float
  composite   Float
  slPct       Float?
  tpPct       Float?
  createdAt   DateTime
  expiresAt   DateTime
  status      String   @default("pending") @db.VarChar(20)

  @@map("pending_action")
  @@index([strategyId])
  @@index([status])
}

model Alert {
  id           String    @id @default(uuid()) @db.VarChar(36)
  type         String    @db.VarChar(50)    // signal | drawdown | daily | backtest | system
  title        String    @db.VarChar(200)
  detail       String?   @db.Text
  severity     String    @default("info") @db.VarChar(20)  // critical | warning | info | success
  ticker       String?   @db.VarChar(20)  // optional linked symbol
  link         String?   @db.VarChar(500) // optional navigation URL
  acknowledged Boolean   @default(false)
  dismissed    Boolean   @default(false)
  snoozedUntil DateTime?
  createdAt    DateTime  @default(now())
  readAt       DateTime?
  // ── Recurrence collapse (2026-09-23) ────────────────────────────────────────────────────────
  // A CONDITION alert (bridge down, data stale, trade blocked) is re-evaluated every poll
  // window. Before these columns, every recurrence inserted a NEW row: "1 MT5 Bridge(s) Down"
  // had 2,210 copies and the table held 12,865 undismissed rows for 1,121 conditions — a badge
  // of 9,818 that trained the reader to ignore the bell. `AlertsService.addAlert()` now updates
  // the existing undismissed row instead, so:
  //   lastSeenAt  — the LAST time the condition was observed (age/auto-dismiss measures from here)
  //   repeatCount — how many times it has been observed since it first appeared
  // ⚠️ `createdAt` remains the FIRST sighting and must never be overwritten: a reader assuming
  // creation time would misread a live condition as an old row.
  lastSeenAt   DateTime? @db.DateTime(3)
  repeatCount  Int       @default(1)

  @@index([type, createdAt])
  @@index([acknowledged, createdAt])
}

// ── Broker Configuration (#589 Phase 1) ──
// Persisted broker capabilities replacing the in-memory PROTOCOL_BROKER_MAP.
model BrokerConfig {
  id                 String   @id @db.VarChar(50)  // brokerId: "mt5", "trading212", "paper", "capital.com"
  displayName        String   @db.VarChar(100)
  supportedStyles    Json                        // ["scalp","day-trade","swing","position","speed"]
  supportedAssetTypes Json                       // ["forex","commodity","index","crypto","stock","etf"]
  tradingEnabled     Boolean  @default(false)
  note               String?  @db.Text
  isActive           Boolean  @default(true)     // admin on/off for this broker
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("broker_config")
}

// Unified Job Queue (#614 Phase 0) — DB-driven job table the automation loop polls.
model ScheduledJob {
  id           String    @id @default(uuid()) @db.VarChar(36)
  type         String    @db.VarChar(50) // 'score-protocol' | 'import-data' | 'execute-trade' | 'fetch-bars'
  status       String    @default("queued") @db.VarChar(20) // queued | running | complete | failed | cancelled
  priority     Int       @default(50) // 0-100, higher runs first
  runAt        DateTime  @default(now()) // next time this job is due
  recurrence   String?   @db.VarChar(20) // null = one-time | 'interval' | 'cron'
  recurrenceMs Int? // for 'interval' — ms between runs (permanent jobs)
  payload      Json? // job-specific data (symbol, protocolId, etc.)
  attempts     Int       @default(0)
  maxAttempts  Int       @default(3)
  lastRunAt    DateTime?
  lastError    String?   @db.Text
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, runAt])
  @@index([type])
  @@map("scheduled_job")
}

// A/B Test Runner (#482) — run two MetaStack snapshots side-by-side.
/// A/B PAIR REGISTRATION (#963, SETTLED-DECISIONS #25).
///
/// ⚠️ WHY A TABLE AND NOT A COLUMN ON `trading_strategy`.
///
/// `duplicatedFromId` already records the LINK (copy → source). A comparison needs more than a
/// link: WHICH single field is under test, WHY (the falsification test, #944), and whether the
/// comparison is currently RUNNING. That last one is the whole reason this exists — it **cannot**
/// be inferred from the two bots' `active` flags, because a freshly duplicated pair is
/// deliberately `incumbent active / variant inactive` (see `duplicate()`), which is byte-identical
/// to a pair that has drifted out of sync. Inferring it would eventually lock an operator out of
/// a legitimate edit.
///
/// `state`: `draft | running | complete | abandoned`.
/// ⚠️ `variantId` is UNIQUE on purpose — a bot is the variant of at most ONE pair, which is what
/// stops a GROUP (two copies of one source) from being silently treated as two pairs.
model AbPair {
  id             String    @id @default(uuid()) @db.VarChar(36)
  incumbentId    String    @db.VarChar(36)
  variantId      String    @db.VarChar(36)
  state          String    @default("draft") @db.VarChar(16)
  declaredChange String?   @db.VarChar(120)
  falsification  String?   @db.Text
  startedAt      DateTime? @db.DateTime(3)
  endedAt        DateTime? @db.DateTime(3)
  createdAt      DateTime  @default(now()) @db.DateTime(3)
  updatedAt      DateTime  @updatedAt @db.DateTime(3)

  @@unique([variantId])
  @@index([incumbentId])
  @@index([state])
  @@map("ab_pair")
}

model AbTest {
  id             String    @id @default(uuid()) @db.VarChar(36)
  name           String    @db.VarChar(200)
  controlStackId String    @db.VarChar(36) // MetaStackSnapshot id (side A)
  variantStackId String    @db.VarChar(36) // MetaStackSnapshot id (side B)
  symbols        Json                       // string[] (max 4)
  startAt        DateTime?
  endAt          DateTime?
  status         String    @default("draft") @db.VarChar(20) // draft | running | complete | cancelled
  results        Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
  @@map("ab_test")
}

// Signal Dismissal (#684, #693) — Signals v1: hide a signal for N hours.
// Keyed on symbol+protocol so dismissals survive reloads and re-scoring.
// Strength columns capture what the user saw at dismissal time — the
// calibration input for the Signals feedback loop (#693).
model SignalDismissal {
  id               String   @id @default(uuid()) @db.VarChar(36)
  symbol           String   @db.VarChar(20)
  protocolId       String   @db.VarChar(50) // 'any' when no protocol specified
  dismissedUntil   DateTime
  combinedStrength Int?
  signalPct        Int?
  opportunityPct   Int?
  dismissCount     Int      @default(1)
  createdAt        DateTime @default(now())

  @@unique([symbol, protocolId])
  @@index([dismissedUntil])
  @@map("signal_dismissal")
}

// Signal Rank Snapshot (#693) — Signals feedback loop: one row per visible
// best-of card per run (throttled to once per hour). Persists the rank and
// strength so forward outcomes can validate the combined-strength ranking.
model SignalRankSnapshot {
  id               String   @id @default(uuid()) @db.VarChar(36)
  symbol           String   @db.VarChar(20)
  protocolId       String   @db.VarChar(50)
  direction        String   @db.VarChar(10)
  rank             Int
  combinedStrength Int
  signalPct        Int?
  opportunityPct   Int?
  confidence       Int?
  scoreId          String?  @db.VarChar(36)
  runAt            DateTime @default(now())

  @@index([runAt])
  @@index([symbol, protocolId])
  @@map("signal_rank_snapshot")
}

// Dynamic Roadmap (#681) — interactive planning state. Issue metadata
// itself comes from the build-time sync dataset; these tables persist
// only what the board changes: columns, positions, owners, dependencies.
model RoadmapCard {
  number     Int      @id
  columnId   String   @db.VarChar(40)
  position   Decimal  @db.Decimal(20, 6)
  ownerAgent String?  @db.VarChar(50)
  blockedBy  Json
  updatedAt  DateTime @updatedAt

  @@index([columnId])
  @@map("roadmap_card")
}

model RoadmapColumn {
  id        String   @id @default(uuid()) @db.VarChar(40)
  title     String   @db.VarChar(100)
  kind      String   @default("sprint") @db.VarChar(20)
  createdAt DateTime @default(now())

  @@map("roadmap_column")
}

/// Registered strategy — the MATERIALISE step of #875.
///
/// The derived view (`StrategyDerivationService`) stays pure and per-read; this table is the
/// durable half: a STABLE id, an optional owner name, and the ACCEPTED parts snapshot the name
/// is pinned to. Drift = the current derived key differs from `strategyKey` → the card shows what
/// changed until the owner re-accepts. `parts` is the whole combination (protocols, bots, symbols,
/// scoring strategies, brokers, treatment) and seeds the full-pipeline backup (#875 part B).
///
/// ⚠️ Auto rows (source 'auto', name null) are minted by the loop for NEWLY MATERIALISED
/// combinations only — a bot whose successor combination already belongs to a registered row is
/// left to drift/re-accept instead, so one combination never gets two identities.
model StrategyRegistry {
  id          String   @id @default(uuid()) @db.VarChar(36)
  strategyKey String   @unique @db.VarChar(64)
  name        String?  @db.VarChar(120)
  source      String   @default("owner") @db.VarChar(20)
  parts       Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
  @@map("strategy_registry")
}
  /// What a BROKER OFFERS — the catalogue, not what the app trades (#958).
  ///
  /// ⚠️ THIS IS NOT `Symbol`, AND CONFLATING THEM IS THE DEFECT THIS TABLE EXISTS TO AVOID.
  /// `symbol` is the ONBOARDED set (257 rows) — instruments the app can see, score and route.
  /// This table is the opposite: everything the broker lists, including instruments the app has
  /// never heard of. Writing 12,373 broker rows into `symbol` would make `getTopMovers`, the tier
  /// resolver and every symbol picker enumerate instruments with no protocol, no route and no bars.
  ///
  /// Measured 2026-09-22 on the MetaQuotes bridge: 12,373 offered, 11,448 at `tradeMode: 4`
  /// (full access), 12,211 of them Nasdaq equities — while the app could see 11. That gap is why
  /// GRML's +539% was invisible: nothing imports this list.
  ///
  /// `registered` is DERIVED at sync time (does a `symbol` row with this ticker exist). It is the
  /// promotion queue: `registered = false` is the discovery backlog, which makes the gap a number
  /// rather than a claim.
  model BrokerSymbol {
    id          String   @id @default(uuid()) @db.VarChar(36)
    brokerId    Int
    name        String   @db.VarChar(64)
    /// Broker's own grouping, e.g. `Nasdaq\GRML`, `Forex\AUDCAD`. First segment is the class.
    path        String?  @db.VarChar(200)
    /// Derived from `path`'s first segment. Denormalised so a filter avoids a LIKE scan.
    assetClass  String?  @db.VarChar(40)
    /// MT5 SYMBOL_TRADE_MODE: 4 = FULL, 0 = DISABLED. NULL = the bridge did not report it.
    tradeMode   Int?
    digits      Int?
    volumeMin   Float?
    volumeMax   Float?
    registered  Boolean  @default(false)
    firstSeenAt DateTime @default(now()) @db.DateTime(3)
    /// ⚠️ The staleness field. A symbol absent from the latest SUCCESSFUL sync carries a
    /// `lastSeenAt` older than `lastSuccessAt` — the only honest way to say "no longer offered".
    lastSeenAt  DateTime @default(now()) @db.DateTime(3)
    updatedAt   DateTime @default(now()) @updatedAt @db.DateTime(3)

    @@unique([brokerId, name])
    @@index([brokerId, assetClass])
    @@index([brokerId, tradeMode])
    @@index([brokerId, registered])
    @@map("broker_symbol")
  }

  /// Sync state per broker — distinguishes "the broker has nothing" from "the broker never
  /// answered". Without it an empty catalogue reads as success, which is the same defect class
  /// as a check that inspects nothing and reports OK.
  model BrokerSymbolSync {
    brokerId        Int       @id
    /// never | ok | unreachable | error
    state           String    @db.VarChar(30)
    reason          String?   @db.Text
    symbolCount     Int       @default(0)
    tradeableCount  Int       @default(0)
    registeredCount Int       @default(0)
    lastSyncAt      DateTime? @db.DateTime(3)
    /// Only advances on a sync that actually read a NON-EMPTY list. `lastSeenAt` is compared
    /// against THIS, so a failed or empty sync can never mark the whole catalogue stale.
    lastSuccessAt   DateTime? @db.DateTime(3)
    updatedAt       DateTime  @default(now()) @updatedAt @db.DateTime(3)

    @@map("broker_symbol_sync")
  }