model ScoringStrategyProtocol {
  id                String   @id @default(uuid()) @db.VarChar(36)
  scoringStrategyId String   @db.VarChar(36)
  protocolSlug      String   @db.VarChar(100)  // references Protocol.slug
  role              String   @default("primary") @db.VarChar(20)  // primary | secondary | correlation
  sortOrder         Int      @default(0)

  scoringStrategy   ScoringStrategy @relation(fields: [scoringStrategyId], references: [id], onDelete: Cascade)

  @@unique([scoringStrategyId, protocolSlug])
  @@map("scoring_strategy_protocol")
}

