// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Symbol {
  id        String   @id @default(uuid()) @db.VarChar(36)
  ticker    String   @unique @db.VarChar(20)
  name      String   @db.VarChar(200)
  exchange  String   @db.VarChar(50)
  type      String   @db.VarChar(50)
  tags      Json     @default("[]")
  aliases   Json     @default("{}")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scores     Score[]
  signals    Signal[]
  marketBars MarketBar[]
  importRuns ImportRun[]
  backtestRuns BacktestRun[]
  recordingSessions TickRecordingSession[]
  positions  Position[]
}

model Strategy {
  id          String   @id @default(uuid()) @db.VarChar(36)
  name        String   @db.VarChar(200)
  description String?  @db.Text
  version     String   @default("1.0.0") @db.VarChar(20)
  config      Json
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  directives Directive[]
  scores     Score[]
  signals    Signal[]
  versions   ProtocolVersion[]
}

model Directive {
  id         String    @id @default(uuid()) @db.VarChar(36)
  strategyId String?   @db.VarChar(36)
  name       String    @db.VarChar(200)
  type       String    @db.VarChar(50)
  weight     Float
  config     Json
  active     Boolean   @default(true)
  nature     String?   @db.VarChar(30)
  parentId   String?   @db.VarChar(36)
  isDefault  Boolean   @default(true)
  forkReason String?   @db.VarChar(500)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  strategy Strategy? @relation(fields: [strategyId], references: [id], onDelete: SetNull)

  @@index([strategyId])
  @@index([parentId])
  @@index([isDefault])
}

model Score {
  id         String   @id @default(uuid()) @db.VarChar(36)
  symbolId   String   @db.VarChar(36)
  strategyId String   @db.VarChar(36)
  value      Float
  breakdown  Json
  timestamp  DateTime @default(now())

  symbol   Symbol   @relation(fields: [symbolId], references: [id], onDelete: Cascade)
  strategy Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  @@index([symbolId, timestamp])
  @@index([strategyId, timestamp])
}

model Signal {
  id         String   @id @default(uuid()) @db.VarChar(36)
  symbolId   String   @db.VarChar(36)
  strategyId String   @db.VarChar(36)
  type       String   @db.VarChar(50)
  strength   Float
  price      Float
  reason     Json
  status     String   @db.VarChar(50)
  createdAt  DateTime @default(now())

  symbol   Symbol   @relation(fields: [symbolId], references: [id], onDelete: Cascade)
  strategy Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  @@index([symbolId, createdAt])
  @@index([strategyId, createdAt])
}

model MarketBar {
  id                  String   @id @default(uuid()) @db.VarChar(36)
  symbolId            String   @db.VarChar(36)
  provider            String   @db.VarChar(50)
  timeframe           String   @db.VarChar(20)
  timestamp           DateTime
  open                Float
  high                Float
  low                 Float
  close               Float
  volume              Float
  recordingSessionId  String?  @db.VarChar(36)
  importedAt          DateTime @default(now())

  symbol            Symbol              @relation(fields: [symbolId], references: [id], onDelete: Cascade)
  recordingSession  TickRecordingSession? @relation(fields: [recordingSessionId], references: [id])

  @@index([symbolId, timeframe, timestamp])
  @@index([provider, importedAt])
  @@index([recordingSessionId])
  @@unique([symbolId, timeframe, timestamp])
}

model ImportRun {
  id          String    @id @default(uuid()) @db.VarChar(36)
  symbolId    String    @db.VarChar(36)
  provider    String    @db.VarChar(50)
  timeframe   String    @db.VarChar(20)
  status      String    @db.VarChar(50)
  source      String    @db.VarChar(100)
  requestedAt DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  error       String?   @db.Text

  symbol Symbol @relation(fields: [symbolId], references: [id], onDelete: Cascade)

  @@index([symbolId, requestedAt])
  @@index([status, requestedAt])
}

// ── Tick Recording Sessions ───────────────────────────────
// Manages live quote recording sessions for sub-minute data.

model TickRecordingSession {
  id         String    @id @default(uuid()) @db.VarChar(36)
  symbolId   String    @db.VarChar(36)
  symbol     Symbol    @relation(fields: [symbolId], references: [id], onDelete: Cascade)
  timeframe  String    @default("5s") @db.VarChar(20)
  status     String    @default("recording") @db.VarChar(20) // recording | paused | completed
  startedAt  DateTime  @default(now())
  endedAt    DateTime?
  barCount   Int       @default(0)
  gapCount   Int       @default(0)
  lastBarAt  DateTime?

  bars       MarketBar[]

  @@index([symbolId, startedAt])
  @@index([status])
}

// ── Backtest Persistence ──────────────────────────────────
// Permanent storage for strategy backtesting results.
// One BacktestRun per execution, many BacktestTrades per run.
// Query by symbol + protocol to see historical performance.

model BacktestRun {
  id           String   @id @default(uuid()) @db.VarChar(36)
  symbolId     String   @db.VarChar(36)
  protocolId   String   @db.VarChar(100)
  timeframe    String   @db.VarChar(10)
  startDate    DateTime
  endDate      DateTime
  totalDays    Int
  totalTrades  Int
  winRate      Float
  totalPnl     Float
  profitFactor Float
  sharpeRatio  Float
  maxDrawdown  Float
  avgTradePnl  Float
  // Execution realism (#50)
  slippage     Float?   // slippage % used
  spread       Float?   // spread % used
  commission   Float?   // commission per trade ($)
  positionModel String? @db.VarChar(30)  // fixedPercent | fixedDollar | atrEqualRisk | kellyFull | kellyHalf
  accountSize  Float?   // starting account balance
  riskPct      Float?   // risk % per trade
  createdAt    DateTime @default(now())

  symbol Symbol         @relation(fields: [symbolId], references: [id], onDelete: Cascade)
  trades BacktestTrade[]

  @@index([symbolId, protocolId])
  @@index([createdAt])
}

model BacktestTrade {
  id         String   @id @default(uuid()) @db.VarChar(36)
  runId      String   @db.VarChar(36)
  symbolId   String   @db.VarChar(36)
  entryDate  DateTime
  entryPrice Float
  exitDate   DateTime
  exitPrice  Float
  direction  String   @db.VarChar(10)  // LONG | SHORT
  pnl        Float
  pnlPct     Float
  exitReason String   @db.VarChar(20)  // TP | SL | EOD
  entryScore Float
  signal     String   @db.VarChar(20)
  // Execution realism (#50)
  positionSize Float?  // number of shares/contracts
  commission   Float?  // commission deducted ($)

  run    BacktestRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([symbolId])
}

model ProviderHealth {
  id            String   @id @default(uuid()) @db.VarChar(36)
  provider      String   @unique @db.VarChar(50)
  status        String   @db.VarChar(50)
  message       String?  @db.Text
  latencyMs     Int?
  checkedAt     DateTime @default(now())
  credentialsOk Boolean  @default(false)
  endpoint      String?  @db.VarChar(500)

  @@index([status, checkedAt])
}

model ApiActivityLog {
  id           String   @id @default(uuid()) @db.VarChar(36)
  timestamp    DateTime @default(now())
  endpoint     String   @db.VarChar(220)
  method       String   @db.VarChar(12)
  provider     String?  @db.VarChar(80)
  statusCode   Int
  durationMs   Int
  responseSize Int      @default(0)

  @@index([timestamp])
  @@index([provider, timestamp])
  @@index([statusCode, timestamp])
  @@index([method, endpoint])
}

model FaqEntry {
  id        String   @id @default(uuid()) @db.VarChar(36)
  question  String   @db.Text
  answer    String   @db.Text
  category  String   @db.VarChar(100)
  tags      String   @db.VarChar(500)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, order])
  @@index([category])
}

model ApiTrace {
  id           String   @id @default(uuid()) @db.VarChar(36)
  cacheKey     String   @db.VarChar(64)
  url          String   @db.VarChar(500)
  method       String   @db.VarChar(10)
  requestBody  String?  @db.Text
  statusCode   Int      @default(0)
  durationMs   Int      @default(0)
  responseBody String?  @db.Text
  preview      String?  @db.VarChar(1000)
  error        String?  @db.Text
  cached       Boolean  @default(false)
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@index([cacheKey, createdAt])
  @@index([createdAt])
  @@index([expiresAt])
}

model CorrelationPair {
  id          String   @id @default(uuid()) @db.VarChar(36)
  symbolA     String   @map("symbol_a") @db.VarChar(20)
  symbolB     String   @map("symbol_b") @db.VarChar(20)
  correlation Float
  periodDays  Int      @default(90) @map("period_days")
  computedAt  DateTime @default(now()) @map("computed_at")

  @@map("correlation_pair")
  @@unique([symbolA, symbolB, periodDays])
  @@index([symbolA])
  @@index([computedAt])
}

model SymbolCalibration {
  id                  String  @id @default(uuid()) @db.VarChar(36)
  symbol              String  @db.VarChar(20)
  directiveId         String  @db.VarChar(100)
  weightMultiplier    Float   @default(1.0)
  reason              String  @db.VarChar(500)
  decayModifier       Float?
  volatilityAdjustment Float?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([symbol, directiveId])
  @@index([symbol])
}

model NewsSource {
  id               String   @id @default(uuid()) @db.VarChar(36)
  name             String   @unique @db.VarChar(200)
  url              String   @db.VarChar(500)
  reliabilityScore Float    @default(5.0)
  patterns         Json
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  articles     ArticleSample[]
  pubPatterns  PublishingPattern[]
  newsArticles NewsArticle[]
}

model ArticleSample {
  id          String   @id @default(uuid()) @db.VarChar(36)
  sourceId    String   @db.VarChar(36)
  headline    String   @db.Text
  url         String?  @db.VarChar(500)
  sentiment   Float    @default(0)
  fluffScore  Float    @default(0)
  publishedAt DateTime
  createdAt   DateTime @default(now())

  source NewsSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId, publishedAt])
  @@index([publishedAt])
}

model PublishingPattern {
  id            String   @id @default(uuid()) @db.VarChar(36)
  sourceId      String   @db.VarChar(36)
  dayOfWeek     Int
  hourOfDay     Int
  avgSentiment  Float    @default(0)
  articleCount  Int      @default(0)
  createdAt     DateTime @default(now())

  source NewsSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, dayOfWeek, hourOfDay])
}

model NewsArticle {
  id          String   @id @default(uuid()) @db.VarChar(36)
  symbol      String   @db.VarChar(20)
  sourceId    String   @db.VarChar(36)
  category    String   @default("general") @db.VarChar(50)
  headline    String   @db.Text
  url         String   @unique @db.VarChar(250)
  summary     String?  @db.Text
  sentiment   Float    @default(0)
  impact      String   @default("medium") @db.VarChar(20)
  publishedAt DateTime
  importedAt  DateTime @default(now())

  source NewsSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([symbol, publishedAt])
  @@index([category, publishedAt])
  @@index([publishedAt])
}

model NewsImportRun {
  id           String   @id @default(uuid()) @db.VarChar(36)
  status       String   @default("running") @db.VarChar(50)
  symbolsCount Int      @default(0)
  fetched      Int      @default(0)
  newArticles  Int      @default(0)
  duplicates   Int      @default(0)
  errors       Int      @default(0)
  errorLog     String?  @db.Text
  startedAt    DateTime @default(now())
  completedAt  DateTime?

  @@index([startedAt])
}

model DirectiveOutcome {
  id               String    @id @default(uuid()) @db.VarChar(36)
  directiveId      String    @db.VarChar(100)
  symbol           String    @db.VarChar(20)
  strategyId       String?   @db.VarChar(36)
  timeframe        String    @db.VarChar(10)
  score            Float
  signalClass      String    @db.VarChar(10)  // bullish | bearish | neutral
  confidence       Float
  predictedAt      DateTime
  priceAtPredict   Float
  priceT15m        Float?
  priceT1h         Float?
  priceT4h         Float?
  priceT24h        Float?
  directionCorrect Boolean?
  outcomeComputedAt DateTime?
  createdAt        DateTime  @default(now())

  @@index([directiveId, symbol, predictedAt])
  @@index([predictedAt])
  @@index([directionCorrect])
}

model MarketSnapshot {
  id              String   @id @default(uuid()) @db.VarChar(36)
  symbol          String   @db.VarChar(20)
  timeframe        String   @db.VarChar(20)
  startTime       DateTime
  endTime         DateTime
  candleData      Json
  directiveScores Json?
  notes           String?  @db.Text
  starred         Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([symbol])
  @@index([starred, createdAt])
}

model AppSetting {
  id    String @id @db.VarChar(100)
  value Json
}

model FeatureFlag {
  id          String   @id @db.VarChar(100)
  enabled     Boolean  @default(false)
  description String?  @db.VarChar(500)
  updatedAt   DateTime @updatedAt
}

// ── Chart Snapshot ────────────────────────────────────────
// Captures chart STATE (not a screenshot image):
// symbol, timeframe, indicators, drawings, annotations.
// Foundation for sharing analysis moments and timeline integration.

model ChartSnapshot {
  id          String   @id @default(uuid()) @db.VarChar(36)
  symbol      String   @db.VarChar(20)
  timeframe   String   @db.VarChar(20)
  indicators  Json     @default("[]")   // [{ id, params }] — which indicators were active
  drawings    Json     @default("[]")   // [{ type, points, label }] — lines, zones, text
  annotations String?  @db.Text         // User notes / analysis text
  visibleRange Json?                    // { from, to } — chart zoom state
  priceAtTime Float?                    // Snapshot price when captured
  tags        Json     @default("[]")   // ["earnings", "breakout", "support-test"]
  createdAt   DateTime @default(now())

  @@index([symbol])
  @@index([symbol, createdAt])
  @@index([createdAt])
}

model ProtocolVersion {
  id         String   @id @default(uuid()) @db.VarChar(36)
  strategyId String   @db.VarChar(36)
  version    String   @db.VarChar(20)
  changes    String   @db.Text
  detectedAt DateTime @default(now())
  previousVersion String? @db.VarChar(20)

  strategy Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  @@index([strategyId, detectedAt])
}

model MacroIndicator {
  id        String   @id @default(uuid()) @db.VarChar(36)
  indicator String   @unique @db.VarChar(100)
  name      String   @db.VarChar(200)
  category  String   @db.VarChar(50)
  unit      String?  @db.VarChar(20)
  value     Float
  previous  Float?
  date      DateTime
  source    String   @db.VarChar(50)
  createdAt DateTime @default(now())

  @@index([category, date])
}

model FxRate {
  id        String   @id @default(uuid()) @db.VarChar(36)
  pair      String   @db.VarChar(20)
  rate      Float
  timestamp DateTime @default(now())
  provider  String   @db.VarChar(50)

  @@index([pair, timestamp])
  @@index([provider, timestamp])
}

// ÔöÇÔöÇ Planned Tables (from Database Tables page) ÔöÇÔöÇ

model SymbolTechnical {
  id         String   @id @default(uuid()) @db.VarChar(36)
  symbolId   String   @db.VarChar(36)
  timeframe  String   @db.VarChar(20)
  indicator  String   @db.VarChar(50)
  value      Float
  computedAt DateTime @default(now())

  @@index([symbolId, timeframe, indicator])
}

model DataSourcesMeta {
  id          String   @id @default(uuid()) @db.VarChar(36)
  name        String   @unique @db.VarChar(200)
  type        String   @db.VarChar(50)
  config      Json
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ApiCredentials {
  id         String   @id @default(uuid()) @db.VarChar(36)
  provider   String   @db.VarChar(50)
  label      String   @db.VarChar(100)
  apiKey     String   @db.Text
  apiSecret  String?  @db.Text
  valid      Boolean  @default(false)
  lastTested DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([provider, label])
}

model StrategyPerformance {
  id          String   @id @default(uuid()) @db.VarChar(36)
  strategyId  String   @db.VarChar(36)
  winRate     Float    @default(0)
  avgReturn   Float    @default(0)
  totalPnl    Float    @default(0)
  sharpeRatio Float?
  totalTrades Int      @default(0)
  periodStart DateTime
  periodEnd   DateTime
  createdAt   DateTime @default(now())

  @@index([strategyId, periodEnd])
}

model UserPreferences {
  id        String   @id @default(uuid()) @db.VarChar(36)
  userId    String   @db.VarChar(50)
  key       String   @db.VarChar(100)
  value     Json
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
}

model Watchlist {
  id          String   @id @default(uuid()) @db.VarChar(36)
  name        String   @db.VarChar(200)
  symbols     Json
  source      String?  @db.VarChar(100)
  protocolId  String?  @db.VarChar(100)
  userId      String?  @db.VarChar(100)
  kind        String   @default("user") @db.VarChar(20)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  importedAt  DateTime?

  scoringStrategies ScoringStrategy[]
}

model CronMeta {
  id         String   @id @default(uuid()) @db.VarChar(36)
  name       String   @unique @db.VarChar(200)
  schedule   String   @db.VarChar(100)
  lastRun    DateTime?
  nextRun    DateTime?
  status     String   @default("idle") @db.VarChar(50)
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ProcessMeta {
  id         String   @id @default(uuid()) @db.VarChar(36)
  name       String   @unique @db.VarChar(200)
  pid        Int?
  port       Int?
  status     String   @default("stopped") @db.VarChar(50)
  startedAt  DateTime?
  stoppedAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model MarketSessions {
  id        String   @id @default(uuid()) @db.VarChar(36)
  session   String   @db.VarChar(50)
  openTime  String   @db.VarChar(10)
  closeTime String   @db.VarChar(10)
  timezone  String   @db.VarChar(50)
  active    Boolean  @default(true)
}

model Order {
  id          String   @id @default(uuid()) @db.VarChar(36)
  symbol      String   @db.VarChar(20)
  type        String   @db.VarChar(50)
  side        String   @db.VarChar(10)
  quantity    Float
  price       Float?
  status      String   @default("pending") @db.VarChar(50)
  provider    String   @db.VarChar(50)
  providerId  String?  @db.VarChar(100)
  accountId   String?  @db.VarChar(100)
  filledAt    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([symbol, createdAt])
  @@index([status])
}

model Position {
  id          String   @id @default(uuid()) @db.VarChar(36)
  symbol      String   @db.VarChar(20)
  symbolId    String?  @db.VarChar(36)
  symbolRef   Symbol?  @relation(fields: [symbolId], references: [id], onDelete: SetNull)
  quantity    Float
  avgPrice    Float
  currentPrice Float?
  pnl         Float?
  provider    String   @db.VarChar(50)
  accountId   String?  @db.VarChar(100)
  lastQuotedAt DateTime?
  openedAt    DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([symbol])
  @@index([symbolId])
  @@index([provider, accountId])
}

model Trade {
  id                String   @id @default(uuid()) @db.VarChar(36)
  symbol            String   @db.VarChar(20)
  side              String   @db.VarChar(10)
  quantity          Float
  entryPrice        Float
  exitPrice         Float?
  pnl               Float?
  status            String   @default("open") @db.VarChar(50)
  provider          String   @db.VarChar(50)
  strategy          String?  @db.VarChar(200)
  scoringStrategyId String?  @db.VarChar(36)
  origin            String   @default("user") @db.VarChar(20)
  openedAt          DateTime @default(now())
  closedAt          DateTime?
  createdAt         DateTime @default(now())

  @@index([symbol, openedAt])
  @@index([status])
  @@index([origin, createdAt])
  @@index([scoringStrategyId])
}

model ApiCalls {
  id         String   @id @default(uuid()) @db.VarChar(36)
  endpoint   String   @db.VarChar(255)
  method     String   @db.VarChar(10)
  provider   String   @db.VarChar(50)
  statusCode Int?
  durationMs Int?
  responseSize Int?
  error      String?  @db.Text
  timestamp  DateTime @default(now())

  @@index([provider, timestamp])
  @@index([timestamp])
}

model CacheMeta {
  id         String   @id @default(uuid()) @db.VarChar(36)
  key        String   @unique @db.VarChar(200)
  ttl        Int      @default(300)
  hitCount   Int      @default(0)
  missCount  Int      @default(0)
  size       Int?
  lastHit    DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model DecodedDocument {
  id                String   @id @default(uuid()) @db.VarChar(36)
  content           String   @db.Text
  format            String   @db.VarChar(50)
  parsedFields      Json
  extractedSymbols  Json
  sentiment         String?  @db.VarChar(20)
  analysis          Json?
  createdAt         DateTime @default(now())

  @@index([format, createdAt])
}

model StrategyMeta {
  id          String   @id @default(uuid()) @db.VarChar(36)
  strategyId  String   @unique @db.VarChar(36)
  category    String   @db.VarChar(50)
  instrumentFocus Json
  expectedReturn String? @db.VarChar(20)
  maxDrawdown String?  @db.VarChar(20)
  winRate     String?  @db.VarChar(20)
  bestCondition String? @db.VarChar(50)
  riskLevel   String   @db.VarChar(20)
  timeHorizon String   @db.VarChar(20)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WatchlistMeta {
  id          String   @id @default(uuid()) @db.VarChar(36)
  watchlistId String   @db.VarChar(36)
  symbol      String   @db.VarChar(20)
  addedAt     DateTime @default(now())
  notes       String?  @db.Text

  @@unique([watchlistId, symbol])
  @@index([symbol])
}

model NewsMeta {
  id          String   @id @default(uuid()) @db.VarChar(36)
  symbol      String?  @db.VarChar(20)
  headline    String   @db.Text
  source      String   @db.VarChar(200)
  url         String?  @db.VarChar(500)
  sentiment   Float    @default(0)
  fluffScore  Float    @default(0)
  impact      String   @default("low") @db.VarChar(20)
  publishedAt DateTime
  ingestedAt  DateTime @default(now())

  @@index([symbol, publishedAt])
  @@index([publishedAt])
}

model OrderExecution {
  id         String   @id @default(uuid()) @db.VarChar(36)
  orderId    String   @db.VarChar(36)
  provider   String   @db.VarChar(50)
