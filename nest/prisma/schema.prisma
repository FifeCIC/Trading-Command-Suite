// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Symbol {
  id        String   @id @default(uuid()) @db.VarChar(36)
  ticker    String   @unique @db.VarChar(20)
  name      String   @db.VarChar(200)
  exchange  String   @db.VarChar(50)
  type      String   @db.VarChar(50)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scores     Score[]
  signals    Signal[]
  marketBars MarketBar[]
  importRuns ImportRun[]
}

model Strategy {
  id          String   @id @default(uuid()) @db.VarChar(36)
  name        String   @db.VarChar(200)
  description String?  @db.Text
  version     String   @default("1.0.0") @db.VarChar(20)
  config      Json
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  directives Directive[]
  scores     Score[]
  signals    Signal[]
  versions   ProtocolVersion[]
}

model Directive {
  id         String   @id @default(uuid()) @db.VarChar(36)
  strategyId String   @db.VarChar(36)
  name       String   @db.VarChar(200)
  type       String   @db.VarChar(50)
  weight     Float
  config     Json
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  strategy Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  @@index([strategyId])
}

model Score {
  id         String   @id @default(uuid()) @db.VarChar(36)
  symbolId   String   @db.VarChar(36)
  strategyId String   @db.VarChar(36)
  value      Float
  breakdown  Json
  timestamp  DateTime @default(now())

  symbol   Symbol   @relation(fields: [symbolId], references: [id], onDelete: Cascade)
  strategy Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  @@index([symbolId, timestamp])
  @@index([strategyId, timestamp])
}

model Signal {
  id         String   @id @default(uuid()) @db.VarChar(36)
  symbolId   String   @db.VarChar(36)
  strategyId String   @db.VarChar(36)
  type       String   @db.VarChar(50)
  strength   Float
  price      Float
  reason     Json
  status     String   @db.VarChar(50)
  createdAt  DateTime @default(now())

  symbol   Symbol   @relation(fields: [symbolId], references: [id], onDelete: Cascade)
  strategy Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  @@index([symbolId, createdAt])
  @@index([strategyId, createdAt])
}

model MarketBar {
  id         String   @id @default(uuid()) @db.VarChar(36)
  symbolId   String   @db.VarChar(36)
  provider   String   @db.VarChar(50)
  timeframe  String   @db.VarChar(20)
  timestamp  DateTime
  open       Float
  high       Float
  low        Float
  close      Float
  volume     Float
  importedAt DateTime @default(now())

  symbol Symbol @relation(fields: [symbolId], references: [id], onDelete: Cascade)

  @@index([symbolId, timeframe, timestamp])
  @@index([provider, importedAt])
}

model ImportRun {
  id          String    @id @default(uuid()) @db.VarChar(36)
  symbolId    String    @db.VarChar(36)
  provider    String    @db.VarChar(50)
  timeframe   String    @db.VarChar(20)
  status      String    @db.VarChar(50)
  source      String    @db.VarChar(100)
  requestedAt DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  error       String?   @db.Text

  symbol Symbol @relation(fields: [symbolId], references: [id], onDelete: Cascade)

  @@index([symbolId, requestedAt])
  @@index([status, requestedAt])
}

model ProviderHealth {
  id            String   @id @default(uuid()) @db.VarChar(36)
  provider      String   @unique @db.VarChar(50)
  status        String   @db.VarChar(50)
  message       String?  @db.Text
  latencyMs     Int?
  checkedAt     DateTime @default(now())
  credentialsOk Boolean  @default(false)
  endpoint      String?  @db.VarChar(500)

  @@index([status, checkedAt])
}

model ApiActivityLog {
  id           String   @id @default(uuid()) @db.VarChar(36)
  timestamp    DateTime @default(now())
  endpoint     String   @db.VarChar(220)
  method       String   @db.VarChar(12)
  provider     String?  @db.VarChar(80)
  statusCode   Int
  durationMs   Int
  responseSize Int      @default(0)

  @@index([timestamp])
  @@index([provider, timestamp])
  @@index([statusCode, timestamp])
  @@index([method, endpoint])
}

model FaqEntry {
  id        String   @id @default(uuid()) @db.VarChar(36)
  question  String   @db.Text
  answer    String   @db.Text
  category  String   @db.VarChar(100)
  tags      String   @db.VarChar(500)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, order])
  @@index([category])
}

model SymbolCalibration {
  id                  String  @id @default(uuid()) @db.VarChar(36)
  symbol              String  @db.VarChar(20)
  directiveId         String  @db.VarChar(100)
  weightMultiplier    Float   @default(1.0)
  reason              String  @db.VarChar(500)
  decayModifier       Float?
  volatilityAdjustment Float?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([symbol, directiveId])
  @@index([symbol])
}

model NewsSource {
  id               String   @id @default(uuid()) @db.VarChar(36)
  name             String   @unique @db.VarChar(200)
  url              String   @db.VarChar(500)
  reliabilityScore Float    @default(5.0)
  patterns         Json
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  articles     ArticleSample[]
  pubPatterns  PublishingPattern[]
  newsArticles NewsArticle[]
}

model ArticleSample {
  id          String   @id @default(uuid()) @db.VarChar(36)
  sourceId    String   @db.VarChar(36)
  headline    String   @db.Text
  url         String?  @db.VarChar(500)
  sentiment   Float    @default(0)
  fluffScore  Float    @default(0)
  publishedAt DateTime
  createdAt   DateTime @default(now())

  source NewsSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId, publishedAt])
  @@index([publishedAt])
}

model PublishingPattern {
  id            String   @id @default(uuid()) @db.VarChar(36)
  sourceId      String   @db.VarChar(36)
  dayOfWeek     Int
  hourOfDay     Int
  avgSentiment  Float    @default(0)
  articleCount  Int      @default(0)
  createdAt     DateTime @default(now())

  source NewsSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, dayOfWeek, hourOfDay])
}

model NewsArticle {
  id          String   @id @default(uuid()) @db.VarChar(36)
  symbol      String   @db.VarChar(20)
  sourceId    String   @db.VarChar(36)
  category    String   @default("general") @db.VarChar(50)
  headline    String   @db.Text
  url         String   @unique @db.VarChar(500)
  summary     String?  @db.Text
  sentiment   Float    @default(0)
  impact      String   @default("medium") @db.VarChar(20)
  publishedAt DateTime
  importedAt  DateTime @default(now())

  source NewsSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([symbol, publishedAt])
  @@index([category, publishedAt])
  @@index([publishedAt])
}

model NewsImportRun {
  id           String   @id @default(uuid()) @db.VarChar(36)
  status       String   @default("running") @db.VarChar(50)
  symbolsCount Int      @default(0)
  fetched      Int      @default(0)
  newArticles  Int      @default(0)
  duplicates   Int      @default(0)
  errors       Int      @default(0)
  errorLog     String?  @db.Text
  startedAt    DateTime @default(now())
  completedAt  DateTime?

  @@index([startedAt])
}

model MarketSnapshot {
  id              String   @id @default(uuid()) @db.VarChar(36)
  symbol          String   @db.VarChar(20)
  timeframe        String   @db.VarChar(20)
  startTime       DateTime
  endTime         DateTime
  candleData      Json
  directiveScores Json?
  notes           String?  @db.Text
  starred         Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([symbol])
  @@index([starred, createdAt])
}

model ProtocolVersion {
  id         String   @id @default(uuid()) @db.VarChar(36)
  strategyId String   @db.VarChar(36)
  version    String   @db.VarChar(20)
  changes    String   @db.Text
  detectedAt DateTime @default(now())
  previousVersion String? @db.VarChar(20)

  strategy Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  @@index([strategyId, detectedAt])
}

model MacroIndicator {
  id        String   @id @default(uuid()) @db.VarChar(36)
  indicator String   @unique @db.VarChar(100)
  name      String   @db.VarChar(200)
  category  String   @db.VarChar(50)
  unit      String?  @db.VarChar(20)
  value     Float
  previous  Float?
  date      DateTime
  source    String   @db.VarChar(50)
  createdAt DateTime @default(now())

  @@index([category, date])
}

model FxRate {
  id        String   @id @default(uuid()) @db.VarChar(36)
  pair      String   @db.VarChar(20)
  rate      Float
  timestamp DateTime @default(now())
  provider  String   @db.VarChar(50)

  @@index([pair, timestamp])
  @@index([provider, timestamp])
}

// ── Planned Tables (from Database Tables page) ──

model SymbolTechnical {
  id         String   @id @default(uuid()) @db.VarChar(36)
  symbolId   String   @db.VarChar(36)
  timeframe  String   @db.VarChar(20)
  indicator  String   @db.VarChar(50)
  value      Float
  computedAt DateTime @default(now())

  @@index([symbolId, timeframe, indicator])
}

model DataSourcesMeta {
  id          String   @id @default(uuid()) @db.VarChar(36)
  name        String   @unique @db.VarChar(200)
  type        String   @db.VarChar(50)
  config      Json
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ApiCredentials {
  id         String   @id @default(uuid()) @db.VarChar(36)
  provider   String   @db.VarChar(50)
  label      String   @db.VarChar(100)
  apiKey     String   @db.Text
  apiSecret  String?  @db.Text
  valid      Boolean  @default(false)
  lastTested DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([provider, label])
}

model StrategyPerformance {
  id          String   @id @default(uuid()) @db.VarChar(36)
  strategyId  String   @db.VarChar(36)
  winRate     Float    @default(0)
  avgReturn   Float    @default(0)
  sharpeRatio Float?
  totalTrades Int      @default(0)
  periodStart DateTime
  periodEnd   DateTime
  createdAt   DateTime @default(now())

  @@index([strategyId, periodEnd])
}

model UserPreferences {
  id        String   @id @default(uuid()) @db.VarChar(36)
  userId    String   @db.VarChar(50)
  key       String   @db.VarChar(100)
  value     Json
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
}

model Watchlist {
  id        String   @id @default(uuid()) @db.VarChar(36)
  name      String   @db.VarChar(200)
  symbols   Json
  userId    String?  @db.VarChar(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CronMeta {
  id         String   @id @default(uuid()) @db.VarChar(36)
  name       String   @unique @db.VarChar(200)
  schedule   String   @db.VarChar(100)
  lastRun    DateTime?
  nextRun    DateTime?
  status     String   @default("idle") @db.VarChar(50)
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ProcessMeta {
  id         String   @id @default(uuid()) @db.VarChar(36)
  name       String   @unique @db.VarChar(200)
  pid        Int?
  port       Int?
  status     String   @default("stopped") @db.VarChar(50)
  startedAt  DateTime?
  stoppedAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model MarketSessions {
  id        String   @id @default(uuid()) @db.VarChar(36)
  session   String   @db.VarChar(50)
  openTime  String   @db.VarChar(10)
  closeTime String   @db.VarChar(10)
  timezone  String   @db.VarChar(50)
  active    Boolean  @default(true)
}

model Order {
  id          String   @id @default(uuid()) @db.VarChar(36)
  symbol      String   @db.VarChar(20)
  type        String   @db.VarChar(50)
  side        String   @db.VarChar(10)
  quantity    Float
  price       Float?
  status      String   @default("pending") @db.VarChar(50)
  provider    String   @db.VarChar(50)
  providerId  String?  @db.VarChar(100)
  accountId   String?  @db.VarChar(100)
  filledAt    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([symbol, createdAt])
  @@index([status])
}

model Position {
  id          String   @id @default(uuid()) @db.VarChar(36)
  symbol      String   @db.VarChar(20)
  quantity    Float
  avgPrice    Float
  currentPrice Float?
  pnl         Float?
  provider    String   @db.VarChar(50)
  accountId   String?  @db.VarChar(100)
  openedAt    DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([symbol])
  @@index([provider, accountId])
}

model Trade {
  id          String   @id @default(uuid()) @db.VarChar(36)
  symbol      String   @db.VarChar(20)
  side        String   @db.VarChar(10)
  quantity    Float
  entryPrice  Float
  exitPrice   Float?
  pnl         Float?
  status      String   @default("open") @db.VarChar(50)
  provider    String   @db.VarChar(50)
  strategy    String?  @db.VarChar(200)
  openedAt    DateTime @default(now())
  closedAt    DateTime?
  createdAt   DateTime @default(now())

  @@index([symbol, openedAt])
  @@index([status])
}

model ApiCalls {
  id         String   @id @default(uuid()) @db.VarChar(36)
  endpoint   String   @db.VarChar(255)
  method     String   @db.VarChar(10)
  provider   String   @db.VarChar(50)
  statusCode Int?
  durationMs Int?
  responseSize Int?
  error      String?  @db.Text
  timestamp  DateTime @default(now())

  @@index([provider, timestamp])
  @@index([timestamp])
}

model CacheMeta {
  id         String   @id @default(uuid()) @db.VarChar(36)
  key        String   @unique @db.VarChar(200)
  ttl        Int      @default(300)
  hitCount   Int      @default(0)
  missCount  Int      @default(0)
  size       Int?
  lastHit    DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model StrategyMeta {
  id          String   @id @default(uuid()) @db.VarChar(36)
  strategyId  String   @unique @db.VarChar(36)
  category    String   @db.VarChar(50)
  instrumentFocus Json
  expectedReturn String? @db.VarChar(20)
  maxDrawdown String?  @db.VarChar(20)
  winRate     String?  @db.VarChar(20)
  bestCondition String? @db.VarChar(50)
  riskLevel   String   @db.VarChar(20)
  timeHorizon String   @db.VarChar(20)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WatchlistMeta {
  id          String   @id @default(uuid()) @db.VarChar(36)
  watchlistId String   @db.VarChar(36)
  symbol      String   @db.VarChar(20)
  addedAt     DateTime @default(now())
  notes       String?  @db.Text

  @@unique([watchlistId, symbol])
  @@index([symbol])
}

model NewsMeta {
  id          String   @id @default(uuid()) @db.VarChar(36)
  symbol      String?  @db.VarChar(20)
  headline    String   @db.Text
  source      String   @db.VarChar(200)
  url         String?  @db.VarChar(500)
  sentiment   Float    @default(0)
  fluffScore  Float    @default(0)
  impact      String   @default("low") @db.VarChar(20)
  publishedAt DateTime
  ingestedAt  DateTime @default(now())

  @@index([symbol, publishedAt])
  @@index([publishedAt])
}

model OrderExecution {
  id         String   @id @default(uuid()) @db.VarChar(36)
  orderId    String   @db.VarChar(36)
  provider   String   @db.VarChar(50)
  providerOrderId String? @db.VarChar(100)
  action     String   @db.VarChar(50)
  status     String   @db.VarChar(50)
  filledQty  Float?
  filledPrice Float?
  fee        Float?
  error      String?  @db.Text
  executedAt DateTime?
  createdAt  DateTime @default(now())

  @@index([orderId])
  @@index([provider, executedAt])
}
