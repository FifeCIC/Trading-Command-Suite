model TradingStrategy {
  id            String   @id @default(uuid()) @db.VarChar(36)
  name          String   @db.VarChar(200)
  description   String?  @db.Text
  version       String   @default("1.0.0") @db.VarChar(20)  // Semver for A/B tracking (#295)
  // Canonical since 2026-08-27 (scoring-strategy retirement): the loop reads
  // these directly. Multi-protocol consumption moves to StrategyProtocol
  // subscriptions; these stay as the legacy single long/short link until the
  // loop consumes subscriptions.
  protocolId    String?  @db.VarChar(36)
  shortProtocolId String? @db.VarChar(36)
  scoringStrategyId String? @db.VarChar(36) // soft link for versioning/performance only (#295)
  // A/B pair lineage (2026-09-22, owner request): the bot this one was COPIED FROM via
  // POST /api/trading/strategies/:id/duplicate. NULL = not a copy. Identity metadata only —
  // it never shapes a trade (declared in bot-rules NON_BEHAVIOURAL_COLUMNS).
  duplicatedFromId String? @db.VarChar(36)
  // #1018 — THE PER-BOT MT5 MAGIC.
  //
  // MT5 stamps `magic` on the order and the value travels with the POSITION for life. It is
  // never truncated (a COMMENT is: `TCS Wellington NZDJPY Sessi` vs a real name of
  // `Wellington NZDJPY Session`) and it cannot be retyped in the terminal — so it is the
  // durable key for "which bot opened this position". Seeded per bot, unique by construction.
  //
  // ⚠️ 234000 is the bridge DEFAULT_MAGIC, meaning "no bot attributed". A per-bot value must
  // not collide with it, so the reserved range starts at 234100. NULL = not yet assigned.
  magic         Int?     @unique
  symbol        String   @db.VarChar(20)
  brokerId      String   @default("mt5") @db.VarChar(50)
  timeframe     String   @db.VarChar(10)   @default("5m")
  // ⚠️ 65 -> 10 (2026-09-15, #839). This is a POLICY default, not a schema convenience.
  //
  // `minComposite` is gated on (automation-loop Gate 4: `gatePct < minC`). Measured `compositePct`
  // peaks at ~33 since the ADR-011 rescale, so a default of 65 meant any INSERT that omitted the
  // field produced a bot that could never fire — silently, with no error. Must equal
  // `BOT_BAR_DEFAULT` in nest/src/common/utils/style-thresholds.ts; verified by
  // nest/scripts/validate-threshold-sources.cjs.
  minComposite  Float    @default(10)
  minRarityBand String?  @db.VarChar(20)
  requireDirection String? @db.VarChar(10)
  slPct         Float?   @default(1.0)
  tpPct         Float?   @default(1.0)
  baseSize      Float?   @default(0.01)
  useRaritySizing Boolean @default(true)
  maxSize       Float?
  maxPositions  Int      @default(1)
  maxPyramidTiers Int    @default(1)  // #344 pyramid averaging — moved from ScoringStrategy (2026-08-27)
  maxDailyLoss  Float?
  // Capital this bot may use, in account CURRENCY — the same unit as `trade.pnl`. No conversion
  // is attempted, and a currency CODE column would duplicate `fund_allocation.currency` and drift.
  //
  // #894: the denominator for `realisedPct` and `maxDrawdownPct`. The rating's required risk
  // condition (drawdown <= 25%) is unverifiable without it, so a NULL here is reported as the
  // `allocation_not_set` blocker rather than skipped — a rating with no risk condition applied is
  // exactly what #894 forbids. NULL = not set, deliberately: there is no honest default.
  //
  // ⚠️ This is NOT a position-size cap. `maxPositions` is a COUNT of positions and this is MONEY.
  // Declared in `bot-rules.ts` (enforcement `display-only` — it shapes a RATING, not a trade) and
  // policed by `nest/scripts/validate-bot-rules.cjs`, which fails the build on an undeclared column.
  allocationAmount Float?
  cooldownMinutes Int    @default(5)
  // Session gate (2026-09-10) — declared market session(s) this bot may act in.
  // JSON array or comma list of tags: 'asian' | 'london' | 'us' (see session-window.ts).
  // NULL / empty = UNGATED: the bot may act any time. The gate is opt-in, so an
  // existing strategy's behaviour is unchanged until it declares a window.
  sessionWindow String?  @db.VarChar(120)
  mode          String   @default("manual") @db.VarChar(20)
  active        Boolean  @default(false)
  // Hot Stock Picks integration (#339)
  hotStockEnabled      Boolean  @default(false)
  hotStockAllocation   Float?   // separate allocation % for hot stock trades
  hotStockDetectionMode String? @db.VarChar(20) // "top-scoring" | "volume-spike" | "all"
  hotStockMaxHoldHours Int?     // shorter max hold for hot stock positions (default: 24h)
  // Position time-stop (#773). NULL = NO LIMIT, so existing strategies are unchanged
  // and nothing closes by surprise.
  //
  // WHY THIS COLUMN EXISTS: `maxHoldDuration` was declared on the TradingStrategy
  // *interface* (`tradeManagement.maxHoldDuration`, default '30d') but was never
  // persisted, so it was never read — and consequently NO time-based exit existed
  // anywhere. Slots filled and stayed filled: measured 2026-09-10, 11 active auto bots
  // shared 5 broker-wide slots, nothing freed them, and 633 decisions produced 2 trades
  // while composites of 81 and 82 sat BLOCKED on "Max open positions (5) reached".
  //
  // Units are HOURS (Int?), not a '30d' string, so a scalp protocol can express a
  // sub-day limit without a parser between config and enforcement.
  maxHoldHours  Int?
  // Simulated TSL — the DECISION-MOMENT exit (#936, R20=A 2026-09-24).
  //
  // WHY PER-BOT AND NOT ONE GLOBAL RULE: the owner chose R20 option A, so post-entry exit
  // management is per-bot data. The StopGuardianService was ONE hardcoded mechanism serving every
  // bot, which is why the thing that actually locks in profit appeared nowhere on the bot page.
  // `trading_strategy.slPct` already spans 0.3%-3% (a 10x range) across live bots, so a single
  // shared trail distance cannot be right for both ends of it.
  //
  // ⚠️ DEFAULT-OFF IS THE CONTRACT. No existing bot changes behaviour, which is what lets this
  // ship without a copied A/B configuration. The mechanism only OBSERVES: it computes a second,
  // TIGHTER threshold that is NEVER sent to the broker, and records the moment price touches it.
  // The broker stop stays where it is, deliberately, so small profits can be locked sooner later
  // without moving real risk.
  //
  // NULL on either number = not configured = not armed. There is deliberately NO default: a
  // guessed trail distance would trail real positions against a fiction.
  //
  // Acting on a decision point (closing or tightening) is a MATHS change and needs an A/B copy —
  // see `.github/instructions/maths-change-requires-ab.instructions.md`.
  simTslEnabled       Boolean @default(false)
  simTslActivationPct Float?
  simTslDistancePct   Float?

  /// #995 — the UP-move exhaustion OBSERVER. ⚠️ Default OFF is the CONTRACT, not a
  /// convenience: no existing bot changes behaviour, so nothing here needs an A/B copy.
  /// ⚠️ NULL `exhaustionDecelPct` means "not configured", never "arm at 0%" — the observer
  /// bails rather than recording firings against a threshold nobody chose.
  exhaustionObserveEnabled Boolean @default(false)
  exhaustionDecelPct       Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // FK deferred — ScoringStrategy table created separately (#470)
  // scoringStrategy ScoringStrategy? @relation(fields: [scoringStrategyId], references: [id])
  evaluations StrategyEvaluation[]
  protocols   StrategyProtocol[]

  @@index([scoringStrategyId])
  @@map("trading_strategy")
}

// StrategyProtocol — protocol subscriptions of a trading strategy (2026-08-31).
// One strategy consumes signals from N protocols; `role` tags the direction
// ('long' | 'short' | 'both'). The loop will consume these (replacing the
// legacy single protocolId/shortProtocolId link).
model StrategyProtocol {
  id         String   @id @default(uuid()) @db.VarChar(36)
  strategyId String   @db.VarChar(36)
  protocolId String   @db.VarChar(100)
  role       String   @default("long") @db.VarChar(10)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  strategy TradingStrategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  @@unique([strategyId, protocolId, role])
  @@index([strategyId])
  @@index([protocolId])
  @@map("strategy_protocol")
}

model StrategyEvaluation {
  id            String   @id @default(uuid()) @db.VarChar(36)
  strategyId    String   @db.VarChar(36)
  symbol        String   @db.VarChar(20)
  composite     Float
  // ⚠️ VarChar(16), NOT 10 — see `ScoreSnapshot.tradingSignal` for why (#1028).
  signal        String   @db.VarChar(16)
  rarityBand    String?  @db.VarChar(20)
  rarityPct     Float?
  direction     String?  @db.VarChar(10)
  traded        Boolean  @default(false)
  /// ⚠️ BIGINT since 2026-09-22 — was `int`; real tickets clamped to 2147483647.
  /// See `DecisionLog.ticket` for the full explanation. 65 rows were affected.
  tradeTicket   BigInt?
  tradeResult   String?  @db.Text
  evaluatedAt   DateTime @default(now())

  strategy TradingStrategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  @@map("strategy_evaluation")
  // Retention column — see the note on DirectiveOutcome.createdAt. `evaluatedAt` must LEAD an
  // index or neither the prune nor the health MIN/MAX can use one.
  @@index([evaluatedAt])
  @@index([strategyId, evaluatedAt])
}

