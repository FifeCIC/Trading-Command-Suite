  tpPct         Float?   @default(1.0)
  baseSize      Float?   @default(0.01)
  useRaritySizing Boolean @default(true)
  maxSize       Float?
  maxPositions  Int      @default(1)
  maxDailyLoss  Float?
  cooldownMinutes Int    @default(5)
  mode          String   @default("manual") @db.VarChar(20)
  active        Boolean  @default(false)
