// ─── Earnings Analysis (multi-source earnings intel) ──────────────────
// Generalised storage for per-symbol earnings predictions/analysis from any
// source (Earnings Whispers, Zacks, Benzinga, …). Sources are normalised in
// the `sources` table and referenced by ID from both the batch and the rows.
//
// ⚠️ CHANGE GUIDANCE — read before touching these models:
//  - `Source` must keep BOTH relation fields (`batches` and `analyses`):
//    Prisma requires every relation to declare its opposite field, and a
//    missing one fails `prisma validate` with P1012 (validation, not lint).
//  - Every snake_case column needs an explicit `@map()`. A missing @map
//    compiles fine but throws P2022 "column does not exist" at runtime the
//    first time that column is written. Add @map as you add columns.
//  - Revenue amounts are NORMALISED TO BILLIONS: `consensusRevenue` and
//    `guidanceRevLow/High` are converted by the parser (millions → /1000).
//    Consumers must not assume raw email units. The *_label columns keep
//    the original human units (e.g. "$2.71B").
//  - `sourceId` is nullable with onDelete:SetNull on purpose: historical
//    batches/rows must survive source deletion, and the backfill migration
//    needs NULL-able columns before assigning the seed source. Do not make
//    these required without a backfill strategy.

model Source {
  id          String   @id @default(uuid()) @db.VarChar(36)
  name        String   @unique @db.VarChar(200)
  slug        String   @unique @db.VarChar(50)
  kind        String   @default("earnings") @db.VarChar(30)
  url         String?  @db.VarChar(500)
  description String?  @db.VarChar(500)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  batches  EarningsAnalysisBatch[]
  analyses EarningsAnalysis[]

  @@map("sources")
  @@index([kind])
}

model EarningsAnalysisBatch {
  id         String   @id @default(uuid()) @db.VarChar(36)
  sourceId   String?  @map("source_id") @db.VarChar(36)
  source     Source?  @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  // The full email dump as pasted — kept verbatim so future AI enrichment or
  // a re-parse never depends on the partial row-level extraction below.
  rawText    String   @map("raw_text") @db.LongText
  entryCount Int      @default(0) @map("entry_count")
  status     String   @default("parsed") @db.VarChar(20)
  createdAt  DateTime @default(now()) @map("created_at")

  entries EarningsAnalysis[]

  @@map("earnings_analysis_batch")
  @@index([sourceId, createdAt])
  @@index([createdAt])
}

model EarningsAnalysis {
  id                     String   @id @default(uuid()) @db.VarChar(36)
  batchId                String?  @map("batch_id") @db.VarChar(36)
  batch                  EarningsAnalysisBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  sourceId               String?  @map("source_id") @db.VarChar(36)
  source                 Source?  @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  symbol                 String   @db.VarChar(20)
  name                   String?  @db.VarChar(200)
  headline               String?  @db.VarChar(255)
  // NOT NULL in the DB: date-only parses are stored at noon UTC (avoids
  // timezone date-shift when read back), and unparseable dates fall back to
  // now() rather than failing the import. See toDbRow() in the service.
  reportDate             DateTime @map("report_date")
  reportTime             String?  @map("report_time") @db.VarChar(40)
  reportDateLabel        String?  @map("report_date_label") @db.VarChar(80)
  consensusEps           Float?   @map("consensus_eps")
  consensusRevenue       Float?   @map("consensus_revenue")
  consensusRevenueLabel  String?  @map("consensus_revenue_label") @db.VarChar(60)
  whisperEps             Float?   @map("whisper_eps")
  guidanceEpsLow         Float?   @map("guidance_eps_low")
  guidanceEpsHigh        Float?   @map("guidance_eps_high")
  guidanceRevLow         Float?   @map("guidance_rev_low")
  guidanceRevHigh        Float?   @map("guidance_rev_high")
  beatPct                Float?   @map("beat_pct")
  beatSide               String?  @map("beat_side") @db.VarChar(10)
  shortInterestChangePct Float?   @map("short_interest_change_pct")
  shortInterestDirection String?  @map("short_interest_direction") @db.VarChar(10)
  impliedMovePct         Float?   @map("implied_move_pct")
  recentAvgMovePct       Float?   @map("recent_avg_move_pct")
  stockChangePct         Float?   @map("stock_change_pct")
  priceVs200dmaPct       Float?   @map("price_vs_200dma_pct")
  dma200Price            Float?   @map("dma_200_price")
  meta                   Json?
  // The per-symbol paragraph this row was extracted from (never truncated).
  // Accuracy tracking and AI enrichment re-read this instead of `meta`.
  rawText                String   @map("raw_text") @db.LongText
  aiSummary              String?  @map("ai_summary") @db.Text
  parsedAt               DateTime @default(now()) @map("parsed_at")
  createdAt              DateTime @default(now()) @map("created_at")

  @@map("earnings_analysis")
  @@index([symbol, reportDate])
  @@index([batchId])
  @@index([sourceId, createdAt])
  @@index([createdAt])
}

