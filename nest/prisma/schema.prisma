// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Symbol {
  id        String   @id @default(uuid()) @db.VarChar(36)
  ticker    String   @unique @db.VarChar(20)
  name      String   @db.VarChar(200)
  exchange  String   @db.VarChar(50)
  type      String   @db.VarChar(50)
  tags      Json     @default("[]")
  aliases   Json     @default("{}")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scores     Score[]
  signals    Signal[]
  marketBars MarketBar[]
  importRuns ImportRun[]
  backtestRuns BacktestRun[]
  recordingSessions TickRecordingSession[]
}

model Strategy {
  id          String   @id @default(uuid()) @db.VarChar(36)
  name        String   @db.VarChar(200)
  description String?  @db.Text
  version     String   @default("1.0.0") @db.VarChar(20)
  config      Json
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  directives Directive[]
  scores     Score[]
  signals    Signal[]
  versions   ProtocolVersion[]
}

model Directive {
  id         String    @id @default(uuid()) @db.VarChar(36)
  strategyId String?   @db.VarChar(36)
  name       String    @db.VarChar(200)
  type       String    @db.VarChar(50)
  weight     Float
  config     Json
  active     Boolean   @default(true)
  parentId   String?   @db.VarChar(36)
  isDefault  Boolean   @default(true)
  forkReason String?   @db.VarChar(500)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  strategy Strategy? @relation(fields: [strategyId], references: [id], onDelete: SetNull)

  @@index([strategyId])
  @@index([parentId])
  @@index([isDefault])
}

model Score {
  id         String   @id @default(uuid()) @db.VarChar(36)
  symbolId   String   @db.VarChar(36)
  strategyId String   @db.VarChar(36)
  value      Float
  breakdown  Json
  timestamp  DateTime @default(now())

  symbol   Symbol   @relation(fields: [symbolId], references: [id], onDelete: Cascade)
  strategy Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  @@index([symbolId, timestamp])
  @@index([strategyId, timestamp])
}

model Signal {
  id         String   @id @default(uuid()) @db.VarChar(36)
  symbolId   String   @db.VarChar(36)
  strategyId String   @db.VarChar(36)
  type       String   @db.VarChar(50)
  strength   Float
  price      Float
  reason     Json
  status     String   @db.VarChar(50)
  createdAt  DateTime @default(now())

  symbol   Symbol   @relation(fields: [symbolId], references: [id], onDelete: Cascade)
  strategy Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  @@index([symbolId, createdAt])
  @@index([strategyId, createdAt])
}

model MarketBar {
  id                  String   @id @default(uuid()) @db.VarChar(36)
  symbolId            String   @db.VarChar(36)
  provider            String   @db.VarChar(50)
  timeframe           String   @db.VarChar(20)
  timestamp           DateTime
  open                Float
  high                Float
  low                 Float
  close               Float
  volume              Float
  recordingSessionId  String?  @db.VarChar(36)
  importedAt          DateTime @default(now())

  symbol            Symbol              @relation(fields: [symbolId], references: [id], onDelete: Cascade)
  recordingSession  TickRecordingSession? @relation(fields: [recordingSessionId], references: [id])

  @@index([symbolId, timeframe, timestamp])
  @@index([provider, importedAt])
  @@index([recordingSessionId])
}

model ImportRun {
  id          String    @id @default(uuid()) @db.VarChar(36)
  symbolId    String    @db.VarChar(36)
  provider    String    @db.VarChar(50)
  timeframe   String    @db.VarChar(20)
  status      String    @db.VarChar(50)
  source      String    @db.VarChar(100)
  requestedAt DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  error       String?   @db.Text

  symbol Symbol @relation(fields: [symbolId], references: [id], onDelete: Cascade)

  @@index([symbolId, requestedAt])
  @@index([status, requestedAt])
}

// ── Tick Recording Sessions ───────────────────────────────
// Manages live quote recording sessions for sub-minute data.

model TickRecordingSession {
  id         String    @id @default(uuid()) @db.VarChar(36)
  symbolId   String    @db.VarChar(36)
  symbol     Symbol    @relation(fields: [symbolId], references: [id], onDelete: Cascade)
  timeframe  String    @default("5s") @db.VarChar(20)
  status     String    @default("recording") @db.VarChar(20) // recording | paused | completed
  startedAt  DateTime  @default(now())
  endedAt    DateTime?
  barCount   Int       @default(0)
  gapCount   Int       @default(0)
  lastBarAt  DateTime?

  bars       MarketBar[]

  @@index([symbolId, startedAt])
  @@index([status])
}

// ── Backtest Persistence ──────────────────────────────────
// Permanent storage for strategy backtesting results.
// One BacktestRun per execution, many BacktestTrades per run.
// Query by symbol + protocol to see historical performance.

model BacktestRun {
  id           String   @id @default(uuid()) @db.VarChar(36)
  symbolId     String   @db.VarChar(36)
  protocolId   String   @db.VarChar(100)
  timeframe    String   @db.VarChar(10)
  startDate    DateTime
  endDate      DateTime
  totalDays    Int
  totalTrades  Int
  winRate      Float
  totalPnl     Float
  profitFactor Float
  sharpeRatio  Float
  maxDrawdown  Float
  avgTradePnl  Float
  createdAt    DateTime @default(now())

  symbol Symbol         @relation(fields: [symbolId], references: [id], onDelete: Cascade)
  trades BacktestTrade[]

  @@index([symbolId, protocolId])
  @@index([createdAt])
}

model BacktestTrade {
  id         String   @id @default(uuid()) @db.VarChar(36)
  runId      String   @db.VarChar(36)
  symbolId   String   @db.VarChar(36)
  entryDate  DateTime
  entryPrice Float
  exitDate   DateTime
  exitPrice  Float
  direction  String   @db.VarChar(10)  // LONG | SHORT
  pnl        Float
  pnlPct     Float
  exitReason String   @db.VarChar(20)  // TP | SL | EOD
  entryScore Float
  signal     String   @db.VarChar(20)

  run    BacktestRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([symbolId])
}

model ProviderHealth {
  id            String   @id @default(uuid()) @db.VarChar(36)
  provider      String   @unique @db.VarChar(50)
  status        String   @db.VarChar(50)
  message       String?  @db.Text
  latencyMs     Int?
  checkedAt     DateTime @default(now())
  credentialsOk Boolean  @default(false)
  endpoint      String?  @db.VarChar(500)

  @@index([status, checkedAt])
}

model ApiActivityLog {
  id           String   @id @default(uuid()) @db.VarChar(36)
  timestamp    DateTime @default(now())
  endpoint     String   @db.VarChar(220)
  method       String   @db.VarChar(12)
  provider     String?  @db.VarChar(80)
  statusCode   Int
  durationMs   Int
  responseSize Int      @default(0)

  @@index([timestamp])
  @@index([provider, timestamp])
  @@index([statusCode, timestamp])
  @@index([method, endpoint])
}

model FaqEntry {
  id        String   @id @default(uuid()) @db.VarChar(36)
  question  String   @db.Text
  answer    String   @db.Text
  category  String   @db.VarChar(100)
  tags      String   @db.VarChar(500)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, order])
  @@index([category])
}

model ApiTrace {
  id           String   @id @default(uuid()) @db.VarChar(36)
  cacheKey     String   @db.VarChar(64)
  url          String   @db.VarChar(500)
  method       String   @db.VarChar(10)
  requestBody  String?  @db.Text
  statusCode   Int      @default(0)
  durationMs   Int      @default(0)
  responseBody String?  @db.Text
  preview      String?  @db.VarChar(1000)
  error        String?  @db.Text
  cached       Boolean  @default(false)
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@index([cacheKey, createdAt])
  @@index([createdAt])
  @@index([expiresAt])
}

model CorrelationPair {
  id          String   @id @default(uuid()) @db.VarChar(36)
  symbolA     String   @map("symbol_a") @db.VarChar(20)
  symbolB     String   @map("symbol_b") @db.VarChar(20)
  correlation Float
  periodDays  Int      @default(90) @map("period_days")
  computedAt  DateTime @default(now()) @map("computed_at")

  @@map("correlation_pair")
  @@unique([symbolA, symbolB, periodDays])
  @@index([symbolA])
  @@index([computedAt])
}

model SymbolCalibration {
  id                  String  @id @default(uuid()) @db.VarChar(36)
  symbol              String  @db.VarChar(20)
  directiveId         String  @db.VarChar(100)
  weightMultiplier    Float   @default(1.0)
  reason              String  @db.VarChar(500)
  decayModifier       Float?
  volatilityAdjustment Float?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([symbol, directiveId])
  @@index([symbol])
}

model NewsSource {
  id               String   @id @default(uuid()) @db.VarChar(36)
  name             String   @unique @db.VarChar(200)
  url              String   @db.VarChar(500)
  reliabilityScore Float    @default(5.0)
  patterns         Json
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  articles     ArticleSample[]
  pubPatterns  PublishingPattern[]
  newsArticles NewsArticle[]
}

model ArticleSample {
  id          String   @id @default(uuid()) @db.VarChar(36)
  sourceId    String   @db.VarChar(36)
  headline    String   @db.Text
  url         String?  @db.VarChar(500)
  sentiment   Float    @default(0)
  fluffScore  Float    @default(0)
  publishedAt DateTime
  createdAt   DateTime @default(now())

  source NewsSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId, publishedAt])
  @@index([publishedAt])
}

model PublishingPattern {
  id            String   @id @default(uuid()) @db.VarChar(36)
  sourceId      String   @db.VarChar(36)
  dayOfWeek     Int
  hourOfDay     Int
  avgSentiment  Float    @default(0)
  articleCount  Int      @default(0)
  createdAt     DateTime @default(now())

  source NewsSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, dayOfWeek, hourOfDay])
}

model NewsArticle {
  id          String   @id @default(uuid()) @db.VarChar(36)
  symbol      String   @db.VarChar(20)
  sourceId    String   @db.VarChar(36)
  category    String   @default("general") @db.VarChar(50)
  headline    String   @db.Text
  url         String   @unique @db.VarChar(250)
  summary     String?  @db.Text
  sentiment   Float    @default(0)
  impact      String   @default("medium") @db.VarChar(20)
  publishedAt DateTime
  importedAt  DateTime @default(now())

  source NewsSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([symbol, publishedAt])
  @@index([category, publishedAt])
  @@index([publishedAt])
}

model NewsImportRun {
  id           String   @id @default(uuid()) @db.VarChar(36)
  status       String   @default("running") @db.VarChar(50)
  symbolsCount Int      @default(0)
  fetched      Int      @default(0)
  newArticles  Int      @default(0)
  duplicates   Int      @default(0)
  errors       Int      @default(0)
  errorLog     String?  @db.Text
  startedAt    DateTime @default(now())
  completedAt  DateTime?

  @@index([startedAt])
}

model DirectiveOutcome {
  id               String    @id @default(uuid()) @db.VarChar(36)
  directiveId      String    @db.VarChar(100)
  symbol           String    @db.VarChar(20)
  strategyId       String?   @db.VarChar(36)
  timeframe        String    @db.VarChar(10)
  score            Float
  signalClass      String    @db.VarChar(10)  // bullish | bearish | neutral
  confidence       Float
  predictedAt      DateTime
  priceAtPredict   Float
  priceT15m        Float?
  priceT1h         Float?
  priceT4h         Float?
  priceT24h        Float?
  directionCorrect Boolean?
  outcomeComputedAt DateTime?
  createdAt        DateTime  @default(now())

  @@index([directiveId, symbol, predictedAt])
  @@index([predictedAt])
  @@index([directionCorrect])
}

model MarketSnapshot {
  id              String   @id @default(uuid()) @db.VarChar(36)
  symbol          String   @db.VarChar(20)
  timeframe        String   @db.VarChar(20)
  startTime       DateTime
  endTime         DateTime
  candleData      Json
  directiveScores Json?
  notes           String?  @db.Text
  starred         Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([symbol])
  @@index([starred, createdAt])
}

model ProtocolVersion {
  id         String   @id @default(uuid()) @db.VarChar(36)
  strategyId String   @db.VarChar(36)
  version    String   @db.VarChar(20)
  changes    String   @db.Text
  detectedAt DateTime @default(now())
  previousVersion String? @db.VarChar(20)

  strategy Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  @@index([strategyId, detectedAt])
}

model MacroIndicator {
  id        String   @id @default(uuid()) @db.VarChar(36)
  indicator String   @unique @db.VarChar(100)
  name      String   @db.VarChar(200)
  category  String   @db.VarChar(50)
  unit      String?  @db.VarChar(20)
  value     Float
  previous  Float?
  date      DateTime
  source    String   @db.VarChar(50)
  createdAt DateTime @default(now())

  @@index([category, date])
}

model FxRate {
  id        String   @id @default(uuid()) @db.VarChar(36)
  pair      String   @db.VarChar(20)
  rate      Float
  timestamp DateTime @default(now())
  provider  String   @db.VarChar(50)

  @@index([pair, timestamp])
  @@index([provider, timestamp])
}

// ÔöÇÔöÇ Planned Tables (from Database Tables page) ÔöÇÔöÇ

model SymbolTechnical {
  id         String   @id @default(uuid()) @db.VarChar(36)
  symbolId   String   @db.VarChar(36)
  timeframe  String   @db.VarChar(20)
  indicator  String   @db.VarChar(50)
  value      Float
  computedAt DateTime @default(now())

  @@index([symbolId, timeframe, indicator])
}

model DataSourcesMeta {
  id          String   @id @default(uuid()) @db.VarChar(36)
  name        String   @unique @db.VarChar(200)
  type        String   @db.VarChar(50)
  config      Json
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ApiCredentials {
  id         String   @id @default(uuid()) @db.VarChar(36)
  provider   String   @db.VarChar(50)
  label      String   @db.VarChar(100)
  apiKey     String   @db.Text
  apiSecret  String?  @db.Text
  valid      Boolean  @default(false)
  lastTested DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([provider, label])
}

model StrategyPerformance {
  id          String   @id @default(uuid()) @db.VarChar(36)
  strategyId  String   @db.VarChar(36)
  winRate     Float    @default(0)
  avgReturn   Float    @default(0)
  totalPnl    Float    @default(0)
  sharpeRatio Float?
  totalTrades Int      @default(0)
  periodStart DateTime
  periodEnd   DateTime
  createdAt   DateTime @default(now())

  @@index([strategyId, periodEnd])
}

model UserPreferences {
  id        String   @id @default(uuid()) @db.VarChar(36)
  userId    String   @db.VarChar(50)
  key       String   @db.VarChar(100)
  value     Json
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
}

model Watchlist {
  id          String   @id @default(uuid()) @db.VarChar(36)
  name        String   @db.VarChar(200)
  symbols     Json
  source      String?  @db.VarChar(100)
  protocolId  String?  @db.VarChar(100)
  userId      String?  @db.VarChar(100)
  kind        String   @default("user") @db.VarChar(20)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  importedAt  DateTime?
}

model CronMeta {
  id         String   @id @default(uuid()) @db.VarChar(36)
  name       String   @unique @db.VarChar(200)
  schedule   String   @db.VarChar(100)
  lastRun    DateTime?
  nextRun    DateTime?
  status     String   @default("idle") @db.VarChar(50)
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ProcessMeta {
  id         String   @id @default(uuid()) @db.VarChar(36)
  name       String   @unique @db.VarChar(200)
  pid        Int?
  port       Int?
  status     String   @default("stopped") @db.VarChar(50)
  startedAt  DateTime?
  stoppedAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model MarketSessions {
  id        String   @id @default(uuid()) @db.VarChar(36)
  session   String   @db.VarChar(50)
  openTime  String   @db.VarChar(10)
  closeTime String   @db.VarChar(10)
  timezone  String   @db.VarChar(50)
  active    Boolean  @default(true)
}

model Order {
  id          String   @id @default(uuid()) @db.VarChar(36)
  symbol      String   @db.VarChar(20)
  type        String   @db.VarChar(50)
  side        String   @db.VarChar(10)
  quantity    Float
  price       Float?
  status      String   @default("pending") @db.VarChar(50)
  provider    String   @db.VarChar(50)
  providerId  String?  @db.VarChar(100)
  accountId   String?  @db.VarChar(100)
  filledAt    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([symbol, createdAt])
  @@index([status])
}

model Position {
  id          String   @id @default(uuid()) @db.VarChar(36)
  symbol      String   @db.VarChar(20)
  quantity    Float
  avgPrice    Float
  currentPrice Float?
  pnl         Float?
  provider    String   @db.VarChar(50)
  accountId   String?  @db.VarChar(100)
  openedAt    DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([symbol])
  @@index([provider, accountId])
}

model Trade {
  id          String   @id @default(uuid()) @db.VarChar(36)
  symbol      String   @db.VarChar(20)
  side        String   @db.VarChar(10)
  quantity    Float
  entryPrice  Float
  exitPrice   Float?
  pnl         Float?
  status      String   @default("open") @db.VarChar(50)
  provider    String   @db.VarChar(50)
  strategy    String?  @db.VarChar(200)
  origin      String   @default("user") @db.VarChar(20)
  openedAt    DateTime @default(now())
  closedAt    DateTime?
  createdAt   DateTime @default(now())

  @@index([symbol, openedAt])
  @@index([status])
  @@index([origin, createdAt])
}

model ApiCalls {
  id         String   @id @default(uuid()) @db.VarChar(36)
  endpoint   String   @db.VarChar(255)
  method     String   @db.VarChar(10)
  provider   String   @db.VarChar(50)
  statusCode Int?
  durationMs Int?
  responseSize Int?
  error      String?  @db.Text
  timestamp  DateTime @default(now())

  @@index([provider, timestamp])
  @@index([timestamp])
}

model CacheMeta {
  id         String   @id @default(uuid()) @db.VarChar(36)
  key        String   @unique @db.VarChar(200)
  ttl        Int      @default(300)
  hitCount   Int      @default(0)
  missCount  Int      @default(0)
  size       Int?
  lastHit    DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model StrategyMeta {
  id          String   @id @default(uuid()) @db.VarChar(36)
  strategyId  String   @unique @db.VarChar(36)
  category    String   @db.VarChar(50)
  instrumentFocus Json
  expectedReturn String? @db.VarChar(20)
  maxDrawdown String?  @db.VarChar(20)
  winRate     String?  @db.VarChar(20)
  bestCondition String? @db.VarChar(50)
  riskLevel   String   @db.VarChar(20)
  timeHorizon String   @db.VarChar(20)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WatchlistMeta {
  id          String   @id @default(uuid()) @db.VarChar(36)
  watchlistId String   @db.VarChar(36)
  symbol      String   @db.VarChar(20)
  addedAt     DateTime @default(now())
  notes       String?  @db.Text

  @@unique([watchlistId, symbol])
  @@index([symbol])
}

model NewsMeta {
  id          String   @id @default(uuid()) @db.VarChar(36)
  symbol      String?  @db.VarChar(20)
  headline    String   @db.Text
  source      String   @db.VarChar(200)
  url         String?  @db.VarChar(500)
  sentiment   Float    @default(0)
  fluffScore  Float    @default(0)
  impact      String   @default("low") @db.VarChar(20)
  publishedAt DateTime
  ingestedAt  DateTime @default(now())

  @@index([symbol, publishedAt])
  @@index([publishedAt])
}

model OrderExecution {
  id         String   @id @default(uuid()) @db.VarChar(36)
  orderId    String   @db.VarChar(36)
  provider   String   @db.VarChar(50)
  providerOrderId String? @db.VarChar(100)
  action     String   @db.VarChar(50)
  status     String   @db.VarChar(50)
  filledQty  Float?
  filledPrice Float?
  fee        Float?
  error      String?  @db.Text
  executedAt DateTime?
  createdAt  DateTime @default(now())

  @@index([orderId])
  @@index([provider, executedAt])
}

model TradingPlan {
  id                String   @id @default(uuid()) @db.VarChar(36)
  title             String   @db.VarChar(200)
  type              String   @default("plan") @db.VarChar(50)
  content           Json
  notes             String?  @db.Text
  status            String   @default("draft") @db.VarChar(20)
  symbols           Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  portfolioSnapshot Json?

  steps PlanStep[]

  @@map("tradingplan")
}

model PlanStep {
  id            String    @id @default(uuid()) @db.VarChar(36)
  planId        String    @db.VarChar(36)
  action        String    @db.VarChar(20)
  symbol        String    @db.VarChar(20)
  quantity      Float?
  targetPrice   Float?
  stopLoss      Float?
  deadline      DateTime?
  conditions    String?   @db.Text
  status        String    @default("pending") @db.VarChar(20)
  sortOrder     Int       @default(0)
  executedAt    DateTime?
  executedPrice Float?
  notes         String?   @db.Text
  createdAt     DateTime  @default(now())

  plan TradingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@map("planstep")
  @@index([planId])
}

model EarningsEvent {
  id               String   @id @default(uuid()) @db.VarChar(36)
  symbol           String   @db.VarChar(20)
  name             String?  @db.VarChar(200)
  reportDate       DateTime @map("report_date")
  fiscalDateEnding DateTime? @map("fiscal_date_ending")
  epsEstimate      Float?   @map("eps_estimate")
  epsActual        Float?   @map("eps_actual")
  revenueEstimate  Float?   @map("revenue_estimate")
  revenueActual    Float?   @map("revenue_actual")
  surprisePercent  Float?   @map("surprise_percent")
  timeOfDay        String?  @map("time_of_day") @db.VarChar(20)
  currency         String?  @db.VarChar(10)
  source           String   @db.VarChar(30)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("earnings_event")
  @@index([reportDate])
  @@index([symbol, reportDate])
  @@index([source, createdAt])
}

model AnalystTarget {
  id            String   @id @default(uuid()) @db.VarChar(36)
  symbol        String   @db.VarChar(20)
  companyName   String?  @map("company_name") @db.VarChar(200)
  currentPrice  Float    @default(0) @map("current_price")
  avgTarget     Float    @default(0) @map("avg_target")
  highTarget    Float    @default(0) @map("high_target")
  lowTarget     Float    @default(0) @map("low_target")
  consensus     String?  @db.VarChar(50)
  analystCount  Int?     @map("analyst_count")
  upside        Float?
  source        String   @db.VarChar(30)
  fetchedAt     DateTime @default(now()) @map("fetched_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("analyst_target")
  @@index([symbol])
  @@index([source, fetchedAt])
}

model ScoreSnapshot {
  id         String   @id @default(uuid()) @db.VarChar(36)
  protocolId String   @db.VarChar(36)
  symbol     String   @db.VarChar(20)
  composite  Float
  tradingSignal String @map("trading_signal") @db.VarChar(10)
  rarityPct  Float?
  snappedAt  DateTime @default(now())

  @@map("score_snapshot")
  @@index([protocolId, snappedAt])
  @@index([symbol, snappedAt])
}

model UserStar {
  id        String   @id @default(uuid()) @db.VarChar(36)
  userId    String   @default("default") @db.VarChar(36)
  itemType  String   @db.VarChar(20)
  itemId    String   @db.VarChar(36)
  createdAt DateTime @default(now())

  @@unique([userId, itemType, itemId])
  @@index([userId, itemType])
}

model TradingStrategy {
  id            String   @id @default(uuid()) @db.VarChar(36)
  name          String   @db.VarChar(200)
  description   String?  @db.Text
  protocolId    String   @db.VarChar(36)
  symbol        String   @db.VarChar(20)
  brokerId      String   @default("mt5") @db.VarChar(50)
  timeframe     String   @db.VarChar(10)   @default("5m")
  minComposite  Float    @default(65)
  minRarityBand String?  @db.VarChar(20)
  requireDirection String? @db.VarChar(10)
  slPct         Float    @default(1.0)
  tpPct         Float    @default(1.0)
  baseSize      Float    @default(0.01)
  useRaritySizing Boolean @default(true)
  maxSize       Float?
  maxPositions  Int      @default(1)
  maxDailyLoss  Float?
  cooldownMinutes Int    @default(5)
  mode          String   @default("manual") @db.VarChar(20)
  active        Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  evaluations StrategyEvaluation[]

  @@map("trading_strategy")
}

model StrategyEvaluation {
  id            String   @id @default(uuid()) @db.VarChar(36)
  strategyId    String   @db.VarChar(36)
  symbol        String   @db.VarChar(20)
  composite     Float
  signal        String   @db.VarChar(10)
  rarityBand    String?  @db.VarChar(20)
  rarityPct     Float?
  direction     String?  @db.VarChar(10)
  traded        Boolean  @default(false)
  tradeTicket   Int?
  tradeResult   String?  @db.Text
  evaluatedAt   DateTime @default(now())

  strategy TradingStrategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  @@map("strategy_evaluation")
  @@index([strategyId, evaluatedAt])
}

model ProtocolRun {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(200)
  protocolId   String   @db.VarChar(100)
  symbols      Json
  status       String   @default("pending") @db.VarChar(20)
  results      Json?
  errorMessage String?  @db.Text
  runCount     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  lastRunAt    DateTime?

  @@index([protocolId])
  @@index([status])
}

model SymbolProtocolAffinity {
  symbol              String   @db.VarChar(20)
  protocolId          String   @db.VarChar(100)
  avgNormalizedScore  Float
  runCount            Int      @default(1)
  lastUpdated         DateTime @default(now())

  @@id([symbol, protocolId])
  @@index([symbol])
  @@index([protocolId])
}

model TimelineEvent {
  id              String   @id @default(uuid())
  type            String   @db.VarChar(50)
  scope           String   @default("global") @db.VarChar(20)
  brokerId        String?  @db.VarChar(50)
  symbol          String?  @db.VarChar(20)
  session         String?  @db.VarChar(20)
  protocolId      String?  @db.VarChar(100)

  action          String   @default("info") @db.VarChar(20)
  riskMultiplier  Float?
  thresholdAdjust Int?

  label           String   @db.VarChar(255)
  description     String?  @db.Text
  icon            String?  @db.VarChar(10)
  color           String?  @db.VarChar(10)

  startsAt        DateTime
  endsAt          DateTime?
  durationMin     Int?

  source          String   @default("system") @db.VarChar(20)
  metadata        Json?

  createdAt       DateTime @default(now())

  @@index([startsAt])
  @@index([symbol])
  @@index([scope, startsAt])
}

model AutomationConfig {
  id                    String   @id @default(uuid())
  brokerId              String   @unique @db.VarChar(50)
  enabled               Boolean  @default(false)
  tradingEnabled        Boolean  @default(false)
  scoreIntervalMs       Int      @default(300000)
  tradeThreshold        Int      @default(65)
  requireConfirmation   Boolean  @default(true)

  pauseOnHighImpactEvents Boolean @default(true)
  earningsGateHours        Int     @default(48)
  useSeasonalityData       Boolean @default(true)
  boostSessionWindows      Boolean @default(true)

  maxDailyTrades        Int      @default(10)
  maxConcurrentPos      Int      @default(3)
  maxLossPerTrade       Float    @default(50.0)

  updatedAt             DateTime @updatedAt
}
