  days      Int
  topCount  Int
  refineCount Int
  stubCount Int
  noDataCount Int
  results   Json     // Full audit results JSON
  runAt     DateTime @default(now())

  @@map("directive_audit_run")
  @@index([symbol, runAt])
}

