// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Symbol {
  id        String   @id @default(uuid()) @db.VarChar(36)
  ticker    String   @unique @db.VarChar(20)
  name      String   @db.VarChar(200)
  exchange  String   @db.VarChar(50)
  type      String   @db.VarChar(50)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scores     Score[]
  signals    Signal[]
  marketBars MarketBar[]
  importRuns ImportRun[]
}

model Strategy {
  id          String   @id @default(uuid()) @db.VarChar(36)
  name        String   @db.VarChar(200)
  description String?  @db.Text
  version     String   @default("1.0.0") @db.VarChar(20)
  config      Json
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  directives Directive[]
  scores     Score[]
  signals    Signal[]
  versions   ProtocolVersion[]
}

model Directive {
  id         String   @id @default(uuid()) @db.VarChar(36)
  strategyId String   @db.VarChar(36)
  name       String   @db.VarChar(200)
  type       String   @db.VarChar(50)
  weight     Float
  config     Json
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  strategy Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  @@index([strategyId])
}

model Score {
  id         String   @id @default(uuid()) @db.VarChar(36)
  symbolId   String   @db.VarChar(36)
  strategyId String   @db.VarChar(36)
  value      Float
  breakdown  Json
  timestamp  DateTime @default(now())

  symbol   Symbol   @relation(fields: [symbolId], references: [id], onDelete: Cascade)
  strategy Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  @@index([symbolId, timestamp])
  @@index([strategyId, timestamp])
}

model Signal {
  id         String   @id @default(uuid()) @db.VarChar(36)
  symbolId   String   @db.VarChar(36)
  strategyId String   @db.VarChar(36)
  type       String   @db.VarChar(50)
  strength   Float
  price      Float
  reason     Json
  status     String   @db.VarChar(50)
  createdAt  DateTime @default(now())

  symbol   Symbol   @relation(fields: [symbolId], references: [id], onDelete: Cascade)
  strategy Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  @@index([symbolId, createdAt])
  @@index([strategyId, createdAt])
}

model MarketBar {
  id         String   @id @default(uuid()) @db.VarChar(36)
  symbolId   String   @db.VarChar(36)
  provider   String   @db.VarChar(50)
  timeframe  String   @db.VarChar(20)
  timestamp  DateTime
  open       Float
  high       Float
  low        Float
  close      Float
  volume     Float
  importedAt DateTime @default(now())

  symbol Symbol @relation(fields: [symbolId], references: [id], onDelete: Cascade)

  @@index([symbolId, timeframe, timestamp])
  @@index([provider, importedAt])
}

model ImportRun {
  id          String    @id @default(uuid()) @db.VarChar(36)
  symbolId    String    @db.VarChar(36)
  provider    String    @db.VarChar(50)
  timeframe   String    @db.VarChar(20)
  status      String    @db.VarChar(50)
  source      String    @db.VarChar(100)
  requestedAt DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  error       String?   @db.Text

  symbol Symbol @relation(fields: [symbolId], references: [id], onDelete: Cascade)

  @@index([symbolId, requestedAt])
  @@index([status, requestedAt])
}

model ProviderHealth {
  id            String   @id @default(uuid()) @db.VarChar(36)
  provider      String   @unique @db.VarChar(50)
  status        String   @db.VarChar(50)
  message       String?  @db.Text
  latencyMs     Int?
  checkedAt     DateTime @default(now())
  credentialsOk Boolean  @default(false)
  endpoint      String?  @db.VarChar(500)

  @@index([status, checkedAt])
}

model ApiActivityLog {
  id           String   @id @default(uuid()) @db.VarChar(36)
  timestamp    DateTime @default(now())
  endpoint     String   @db.VarChar(220)
  method       String   @db.VarChar(12)
  provider     String?  @db.VarChar(80)
  statusCode   Int
  durationMs   Int
  responseSize Int      @default(0)

  @@index([timestamp])
  @@index([provider, timestamp])
  @@index([statusCode, timestamp])
  @@index([method, endpoint])
}

model FaqEntry {
  id        String   @id @default(uuid()) @db.VarChar(36)
  question  String   @db.Text
  answer    String   @db.Text
  category  String   @db.VarChar(100)
  tags      String   @db.VarChar(500)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, order])
  @@index([category])
}

model SymbolCalibration {
  id                  String  @id @default(uuid()) @db.VarChar(36)
  symbol              String  @db.VarChar(20)
  directiveId         String  @db.VarChar(100)
  weightMultiplier    Float   @default(1.0)
  reason              String  @db.VarChar(500)
  decayModifier       Float?
  volatilityAdjustment Float?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([symbol, directiveId])
  @@index([symbol])
}

model NewsSource {
  id               String   @id @default(uuid()) @db.VarChar(36)
  name             String   @unique @db.VarChar(200)
  url              String   @db.VarChar(500)
  reliabilityScore Float    @default(5.0)
  patterns         Json
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  articles     ArticleSample[]
  pubPatterns  PublishingPattern[]
}

model ArticleSample {
  id          String   @id @default(uuid()) @db.VarChar(36)
  sourceId    String   @db.VarChar(36)
  headline    String   @db.Text
  url         String?  @db.VarChar(500)
  sentiment   Float    @default(0)
  fluffScore  Float    @default(0)
  publishedAt DateTime
  createdAt   DateTime @default(now())

  source NewsSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId, publishedAt])
  @@index([publishedAt])
}

model PublishingPattern {
  id            String   @id @default(uuid()) @db.VarChar(36)
  sourceId      String   @db.VarChar(36)
  dayOfWeek     Int
  hourOfDay     Int
  avgSentiment  Float    @default(0)
  articleCount  Int      @default(0)
  createdAt     DateTime @default(now())

  source NewsSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, dayOfWeek, hourOfDay])
}

model MarketSnapshot {
  id              String   @id @default(uuid()) @db.VarChar(36)
  symbol          String   @db.VarChar(20)
  timeframe        String   @db.VarChar(20)
  startTime       DateTime
  endTime         DateTime
  candleData      Json
  directiveScores Json?
  notes           String?  @db.Text
  starred         Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([symbol])
  @@index([starred, createdAt])
}

model ProtocolVersion {
  id         String   @id @default(uuid()) @db.VarChar(36)
  strategyId String   @db.VarChar(36)
  version    String   @db.VarChar(20)
  changes    String   @db.Text
  detectedAt DateTime @default(now())
  previousVersion String? @db.VarChar(20)

  strategy Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  @@index([strategyId, detectedAt])
}

model MacroIndicator {
  id        String   @id @default(uuid()) @db.VarChar(36)
  indicator String   @unique @db.VarChar(100)
  name      String   @db.VarChar(200)
  category  String   @db.VarChar(50)
  unit      String?  @db.VarChar(20)
  value     Float
  previous  Float?
  date      DateTime
  source    String   @db.VarChar(50)
  createdAt DateTime @default(now())

  @@index([category, date])
}
