// ── Decision Log ─────────────────────────────────────────
// Persists automation loop decisions across restarts.
// One row per strategy evaluation per tick.

model DecisionLog {
  id          String   @id @default(uuid()) @db.VarChar(36)
  timestamp   DateTime @default(now())
  tickNumber  Int
  strategyId  String   @db.VarChar(36)
  symbol      String   @db.VarChar(20)
  decision    String   @db.VarChar(20)   // SCORED, SKIP, EXECUTED, FAILED, BLOCKED, QUEUED, HOLD
  reason      String?  @db.Text
  /// Raw additive protocol score — the envelope-ladder and A/B writers (#909).
  /// NEVER compare to a percentage threshold; this is the same number the protocol
  /// capacity is measured against (e.g. 178 of 910).
  compositeRaw Float?
  /// Percentage of the protocol's CONFIGURED capacity, 0-100 — the queue-path writer (#909).
  /// This is the number `minComposite` gates were calibrated for.
  compositePct Float?
  /// ⚠️ HISTORICAL ONLY (#909) — the column that held BOTH units above, unlabelled.
  /// Nothing writes it any more; it is kept because 141k pre-split rows cannot be
  /// classified with certainty (their writer era is not recoverable). Do NOT aggregate,
  /// average or compare this column — its unit is unknown per row. Read `compositeRaw`
  /// and `compositePct` instead; a reader that shows this must label it as untyped.
  composite   Float?
  // ⚠️ VarChar(16), NOT 10 (#1028, 2026-09-30). `STRONG_SELL` is ELEVEN characters; at VarChar(10)
  // it was truncated to `STRONG_SEL` on write — 726 rows. The comment here used to read
  // "BUY, SELL, HOLD", which was the OBSERVATION and not the CONTRACT: the column really receives
  // STRONG_BUY too (2,166 rows), so the class vocabulary was always wider than the declared width.
  signal      String?  @db.VarChar(16)    // BUY | STRONG_BUY | SELL | STRONG_SELL | HOLD
  /// ⚠️ BIGINT since 2026-09-22 — was `int`, and this is the column that proved the bug.
  /// MySQL's `sql_mode` is empty (non-strict), so an out-of-range write is clamped rather
  /// than rejected: `automation-loop.service.ts` passes a REAL 12-digit broker ticket here,
  /// and 104 of 108 rows came back as 2147483647.
  ///
  /// 🛑 `2147483647` IS NOT A PLACEHOLDER — it is a symptom of the clamp. An earlier comment
  /// in `decision-chain.service.ts` read it as a sentinel and skipped the join on that basis,
  /// which means the score→evaluation link was quietly abandoned for every clamped trade.
  /// Historical rows still hold the clamped value (unrecoverable); new rows are correct.
  ticket      BigInt?
  price       Float?
  quantity    Float?

  @@map("decision_log")
  @@index([timestamp])
  @@index([strategyId, timestamp])
  @@index([symbol, timestamp])
}

// ── Decision Trail ──────────────────────────────────────
// Captures the LONG vs SHORT protocol comparison that drives
// every trading decision. Currently computed in-memory and
// discarded after each tick (#350, #474).
//
// One row per strategy per tick — whether or not a trade executed.
// Links to score_snapshot (via timestamp+symbol+strategy) and
// trade (via tradeTicket) for full-chain traceability.

model DecisionTrail {
  id              String   @id @default(uuid()) @db.VarChar(36)
  tickNumber      Int
  timestamp       DateTime @default(now())
  strategyId      String   @db.VarChar(36)
  symbol          String   @db.VarChar(20)
  // LONG side
  longProtocolId  String?  @db.VarChar(100)
  longComposite   Float    @default(0)
  // ⚠️ VarChar(16), NOT 10 (#1028). These three are EMPTY today, and widened anyway: they are named
  // for signal classes, so the first writer to place a STRONG_SELL here would silently truncate it
  // exactly as `decision_log.signal` did. An empty column is not evidence that the width is right.
  longSignal      String?  @db.VarChar(16)
  // SHORT side
  shortProtocolId String?  @db.VarChar(100)
  shortComposite  Float    @default(0)
  shortSignal     String?  @db.VarChar(16)
  // Outcome
  winner          String?  @db.VarChar(10)   // LONG | SHORT | NONE
  chosenComposite Float    @default(0)
  finalSignal     String?  @db.VarChar(16)   // BUY | STRONG_BUY | SELL | STRONG_SELL | HOLD
  reason          String?  @db.Text
  actionable      Boolean  @default(false)
  // Trade result (only if a trade executed)
  /// ⚠️ BIGINT since 2026-09-22 — was `int`; real tickets clamped to 2147483647.
  /// See `DecisionLog.ticket` for the full explanation.
  tradeTicket     BigInt?
  tradeVolume     Float?
  tradePrice      Float?

  // ── Chain linking (#475) — FK targets for joined audit queries ──
  // Populated progressively as the pipeline advances.
  // DB-level FKs are omitted due to MySQL engine mix; Prisma handles
  // joins at the application level via `include`.
  scoreSnapshotId String?  @db.VarChar(36)
  strategyEvalId  String?  @db.VarChar(36)
  tradeId         String?  @db.VarChar(36)

  @@map("decision_trail")
  @@index([timestamp])
  @@index([strategyId, tickNumber])
  @@index([symbol, timestamp])
  @@index([actionable])
  @@index([scoreSnapshotId])
  @@index([strategyEvalId])
  @@index([tradeId])
}

// ── Stop Adjustment (#476) ──────────────────────────────
// Tracks every SL/TP modification — whether by Stop Guardian
// automation or manual amend. Links back to the trade and
// records the directive scores that triggered the change.

model StopAdjustment {
  id              String   @id @default(uuid()) @db.VarChar(36)
  tradeTicket     String   @db.VarChar(100)
  symbol          String   @db.VarChar(20)
  oldSl           Float?
  newSl           Float?
  oldTp           Float?
  newTp           Float?
  reason          String   @db.VarChar(200)
  directiveScores Json?
  adjustedAt      DateTime @default(now())

  @@map("stop_adjustment")
  @@index([tradeTicket])
  @@index([symbol, adjustedAt])
}

// SimTslEvent — the recorded firings of the per-bot SIMULATED TSL (#936).
//
// ⚠️ WHY THIS TABLE EXISTS AT ALL. #936's own caveat: "its firings must be recorded so a
// decision-moment close is distinguishable from the broker stop being hit." Without this table a
// close at a decision point and a close at the broker stop are the same row, and the whole point
// of the mechanism — locking in small profits sooner, with the broker stop left further away —
// becomes unmeasurable.
//
// `action` is 'recorded' and that is the ONLY value the engine writes today. Nothing here sends
// anything to a broker; the table records that a decision moment OCCURRED.
model SimTslEvent {
  id            String   @id @default(uuid()) @db.VarChar(36)
  tradeTicket   String   @db.VarChar(100)
  strategyId    String?  @db.VarChar(36)
  strategyName  String?  @db.VarChar(200)
  symbol        String   @db.VarChar(20)
  /// 'armed' | 'decision-point' | 'cleared'. Only 'decision-point' is a decision moment.
  event         String   @db.VarChar(30)
  entryPrice    Float?
  /// The level the simulated threshold sat at, and the price observed when it was touched.
  triggerPrice  Float?
  price         Float?
  profitPct     Float?
  distancePct   Float?
  activationPct Float?
  action        String   @default("recorded") @db.VarChar(30)
  detail        Json?
  occurredAt    DateTime @default(now())

  @@map("sim_tsl_event")
  @@index([tradeTicket, occurredAt])
  @@index([symbol, occurredAt])
  @@index([strategyId, occurredAt])
  // Retention column must LEAD an index (validate-retention-columns.cjs).
  @@index([occurredAt])
}

// ExhaustionEvent — the recorded firings of the UP-move exhaustion OBSERVER (#995).
//
// ⚠️ WHY THIS EXISTS AT ALL. #995's theory (`upside-exhaustion-predicts-giveback`, status
// `testing`) is falsifiable ONLY IF the firings are recorded: comparing peak giveback on flagged
// versus unflagged closed positions needs the flagged set to be identifiable AFTER the fact.
// Without this table the theory can only ever be argued, never tested.
model ExhaustionEvent {
  id                String   @id @default(uuid()) @db.VarChar(36)
  tradeTicket       String   @db.VarChar(100)
  strategyId        String?  @db.VarChar(36)
  strategyName      String?  @db.VarChar(200)
  symbol            String   @db.VarChar(20)
  /// The direction of the OPEN POSITION being watched — a 'sell' position's exhaustion is a
  /// FALLING move decelerating, which is the same code path mirrored.
  side              String   @db.VarChar(10)
  /// ⚠️ 'observed' is the ONLY event value the engine writes. There is no 'acted'.
  event             String   @default("observed") @db.VarChar(30)
  entryPrice        Float?
  price             Float?
  /// Highest (lowest for a sell) close in the evaluated window — what the move achieved.
  peakPrice         Float?
  profitPct         Float?
  /// Net progress over the last k bars, and over the k bars before those, as % of price. The
  /// comparison between them IS the signal, so both are stored raw rather than as a verdict.
  recentProgressPct Float?
  priorProgressPct  Float?
  /// (prior − recent) ÷ prior × 100. Stored so the threshold can be RE-EVALUATED later against
  /// the same recorded firings, without re-observing anything.
  decelPct          Float?
  thresholdPct      Float?
  barsUsed          Int?
  /// ⚠️ 'recorded' is the only value written. Nothing reaches the broker from this code path.
  action            String   @default("recorded") @db.VarChar(30)
  detail            Json?
  occurredAt        DateTime @default(now())

  @@map("exhaustion_event")
  @@index([tradeTicket, occurredAt])
  @@index([symbol, occurredAt])
  @@index([strategyId, occurredAt])
  // Retention column must LEAD an index (validate-retention-columns.cjs).
  @@index([occurredAt])
}

// ── Audit trail ──────────────────────────────────────────
// Step-by-step trace of every decision point in the
// automation tick loop. Queryable for diagnostics.

model AutomationEvent {
  id          String   @id @default(uuid()) @db.VarChar(36)
  timestamp   DateTime @default(now())
  tickNumber  Int
  strategyId  String?  @db.VarChar(36)
  symbol      String?  @db.VarChar(20)
  step        String   @db.VarChar(60)   // e.g. 'tick_start', 'bars_fetched', 'scored', 'gated', 'dispatch', 'order_sent', 'order_result'
  decision    String?  @db.VarChar(20)    // BUY, SELL, HOLD, SKIP, EXECUTED, FAILED, BLOCKED
  detail      String?  @db.Text           // JSON payload with step-specific data
  durationMs  Int?

  @@map("automation_event")
  @@index([tickNumber])
  @@index([strategyId, tickNumber])
  @@index([symbol, timestamp])
  @@index([step, timestamp])
  // Retention column — see the note on DirectiveOutcome.createdAt. `timestamp` was only ever the
  // SECOND column of the indexes above.
  @@index([timestamp])
}

// ── Directive Audit Runs ─────────────────────────────────
// Trend storage for directive performance audits (#283).
// Each run captures the full classification snapshot.

model DirectiveAuditRun {
  id        String   @id @default(uuid()) @db.VarChar(36)
