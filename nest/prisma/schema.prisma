  status               String   @default("ALPHA") @db.VarChar(30)
  notes                String?  @db.Text
  dataPersistence      String   @default("ephemeral") @db.VarChar(30)
  uiSurfaces           Int      @default(0)
  pipelineIntegration  String   @default("none") @db.VarChar(30)
  devCompletion        String   @default("partial") @db.VarChar(30)
