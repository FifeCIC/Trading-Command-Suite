  twitterSentiment Float    @default(0)       // -1 to 1
  totalMentions    Int      @default(0)
  avgSentiment     Float    @default(0)       // -1 to 1
  source           String   @default("finnhub") @db.VarChar(30)
  fetchedAt        DateTime @default(now())

  @@index([symbol, fetchedAt])
  @@index([fetchedAt])
}

// ── Insider Transactions ──────────────────────────────────
// Stores insider buying/selling records from Finnhub.
