// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// ═══════════════════════════════════════════════════════════════════════════════════════
// 🛑  DO NOT RUN `prisma db push` AGAINST THIS PROJECT
// ═══════════════════════════════════════════════════════════════════════════════════════
//
// This file is NOT the complete truth about the database, and `db push` assumes it is.
// `db push` drops every table with no model here — and TEN tables are managed OUTSIDE
// Prisma, because the faster-moving subsystems create them with raw SQL and access them
// via $queryRawUnsafe:
//
//   strategy_signal_queue   ← THE TRADE EXECUTION QUEUE (money path, 12 code references)
//   paper_trade             ← paper-trading ledger
//   signal_outcome_log      ← one row per persisted signal
//   signal_outcome_meta     ← blocker / conflict / warning entries
//   *_backup_*_20260910 (6) ← rollback path for the #750 timestamp repair (195k+ rows)
//
// Four of those have no CREATE TABLE anywhere in the repo — they exist only in the running
// database. There is also NO migration history (no _prisma_migrations, no migrations/), so
// drift cannot be reconciled against anything.
//
// It does not error. It prints a warning list, waits for a `y`, and deletes them.
//
// WHAT TO DO INSTEAD
//   Add a column:   ALTER TABLE <t> ADD COLUMN ... ; npx prisma generate  (API stopped)
//   Add a table:    targeted CREATE TABLE, then add the model below in the same commit
//   Raw-managed:    capture DDL to nest/prisma/raw-managed/<t>.sql AND declare it in
//                   nest/scripts/validate-schema-safety.cjs (reason + owning module)
//   Verify first:   npm --prefix nest run db:check
//
// Rules:   .github/instructions/database-schema.instructions.md
// Detail:  docs/schema-drift-control.md   ·   Issue: #769
// ═══════════════════════════════════════════════════════════════════════════════════════

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Symbol {
  id        String   @id @default(uuid()) @db.VarChar(36)
  ticker    String   @unique @db.VarChar(20)
  name      String   @db.VarChar(200)
  // ⚠️ NULLABLE since 2026-09-23 (#959). It was `NOT NULL`, which forced a value to be invented
  // for a symbol that has no exchange — and the onboarding seeder supplied `'Xtrend'` on 29 rows.
  // There is no Xtrend exchange and no Xtrend adapter; the label was fabricated. Measured 12% of
  // rows carried a value that could not be true (`Xtrend`, `MetaQuotes`, `Unknown`).
  //
  // ⚠️ This column is a SOURCE LABEL, not an exchange. It holds `Yahoo`, `Trading212`, `Binance`
  // from the import paths, and `mt5`/`binance` after #959 reconciled it to `marketbar.provider` —
  // the AUTHORITATIVE field. It is NOT `symbol_route.provider` (a different table; see
  // docs/symbol-data-coverage-audit.md). Absence is a real state: an MT5 CFD has no exchange, and
  // a symbol that has never delivered a bar has no source either.
  exchange  String?  @db.VarChar(50)
  type      String   @db.VarChar(50)
  tags      Json     @default("[]")
  aliases   Json     @default("{}")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scores     Score[]
  signals    Signal[]
  marketBars MarketBar[]
  importRuns ImportRun[]
  backtestRuns BacktestRun[]
  backtestPeriods BacktestPeriod[]
  recordingSessions TickRecordingSession[]
  positions  Position[]
}

model Strategy {
  id          String   @id @default(uuid()) @db.VarChar(36)
  name        String   @db.VarChar(200)
  description String?  @db.Text
  version     String   @default("1.0.0") @db.VarChar(20)
  config      Json
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  directives Directive[]
  scores     Score[]
  signals    Signal[]
  versions   ProtocolVersion[]
}

model Directive {
  id         String    @id @default(uuid()) @db.VarChar(36)
  strategyId String?   @db.VarChar(36)
  name       String    @db.VarChar(200)
  type       String    @db.VarChar(50)
  weight     Float
  config     Json
  active     Boolean   @default(true)
  nature     String?   @db.VarChar(30)
  readiness  String    @default("alpha") @db.VarChar(10)
  parentId   String?   @db.VarChar(36)
  isDefault  Boolean   @default(true)
  forkReason String?   @db.VarChar(500)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  strategy Strategy? @relation(fields: [strategyId], references: [id], onDelete: SetNull)

  @@index([strategyId])
  @@index([parentId])
  @@index([isDefault])
}

model Score {
  id         String   @id @default(uuid()) @db.VarChar(36)
  symbolId   String   @db.VarChar(36)
  strategyId String   @db.VarChar(36)
  value      Float
  breakdown  Json
  timestamp  DateTime @default(now())

  symbol   Symbol   @relation(fields: [symbolId], references: [id], onDelete: Cascade)
  strategy Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  @@index([symbolId, timestamp])
  @@index([strategyId, timestamp])
  @@index([timestamp])
}

model Signal {
  id         String   @id @default(uuid()) @db.VarChar(36)
  symbolId   String   @db.VarChar(36)
  strategyId String   @db.VarChar(36)
  type       String   @db.VarChar(50)
  strength   Float
  price      Float
  reason     Json
  status     String   @db.VarChar(50)
  createdAt  DateTime @default(now())

  symbol   Symbol   @relation(fields: [symbolId], references: [id], onDelete: Cascade)
  strategy Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  @@index([symbolId, createdAt])
  @@index([strategyId, createdAt])
}

model MarketBar {
  id                  String   @id @default(uuid()) @db.VarChar(36)
  symbolId            String   @db.VarChar(36)
  provider            String   @db.VarChar(50)
  timeframe           String   @db.VarChar(20)
  timestamp           DateTime
  open                Float
  high                Float
  low                 Float
  close               Float
  volume              Float
  recordingSessionId  String?  @db.VarChar(36)
  importedAt          DateTime @default(now())

  symbol            Symbol              @relation(fields: [symbolId], references: [id], onDelete: Cascade)
  recordingSession  TickRecordingSession? @relation(fields: [recordingSessionId], references: [id])

  @@index([symbolId, timeframe, timestamp])
  @@index([provider, importedAt])
  @@index([recordingSessionId])
  // Retention column — see the note on DirectiveOutcome.createdAt. `timestamp` was only ever the
  // THIRD column of the indexes above, so the prune `WHERE timestamp < cutoff` could not use one.
  @@index([timestamp])
  @@unique([symbolId, timeframe, timestamp])
}

model ImportRun {
  id          String    @id @default(uuid()) @db.VarChar(36)
  symbolId    String    @db.VarChar(36)
  provider    String    @db.VarChar(50)
  timeframe   String    @db.VarChar(20)
  status      String    @db.VarChar(50)
  source      String    @db.VarChar(100)
  requestedAt DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  error       String?   @db.Text

  symbol Symbol @relation(fields: [symbolId], references: [id], onDelete: Cascade)

  @@index([symbolId, requestedAt])
  @@index([status, requestedAt])
}

// ── Tick Recording Sessions ───────────────────────────────
// Manages live quote recording sessions for sub-minute data.

model TickRecordingSession {
  id         String    @id @default(uuid()) @db.VarChar(36)
  symbolId   String    @db.VarChar(36)
  symbol     Symbol    @relation(fields: [symbolId], references: [id], onDelete: Cascade)
  timeframe  String    @default("5s") @db.VarChar(20)
  status     String    @default("recording") @db.VarChar(20) // recording | paused | completed
  startedAt  DateTime  @default(now())
  endedAt    DateTime?
  barCount   Int       @default(0)
  gapCount   Int       @default(0)
  lastBarAt  DateTime?

  bars       MarketBar[]

  @@index([symbolId, startedAt])
  @@index([status])
}

// ── Backtest Persistence ──────────────────────────────────
// Permanent storage for strategy backtesting results.
// One BacktestRun per execution, many BacktestTrades per run.
// Query by symbol + protocol to see historical performance.

model BacktestRun {
  id           String   @id @default(uuid()) @db.VarChar(36)
  symbolId     String   @db.VarChar(36)
  protocolId   String   @db.VarChar(100)
  timeframe    String   @db.VarChar(10)
  startDate    DateTime
  endDate      DateTime
  totalDays    Int
  totalTrades  Int
  // ⚠️ ADDED 2026-09-23 (#965 item 1). `winRate` on this row is a SIGNAL rate
  // (`profitable / entrySignals`) while `totalTrades` is a TRADE count — two populations on one
  // row, and the DENOMINATOR of `winRate` was never persisted, so the sample that `winRate` (and
  // `sharpeRatio`, computed from the same entry signals) rests on could not be stated at all.
  // A verdict must name its sample: a bar on trades alone would still let the verdict's own metric
  // rest on an unrecorded population. NULL = NOT RECORDED (runs before this column), deliberately
  // distinct from 0 = no signals.
  totalSignals Int?
  // ⚠️ ADDED 2026-09-23 (#965 item 4) — WHAT produced this run, so a comparison can check
  // like-for-like before anyone reads a difference as a result. The two Gold bots in the XAU pair
  // are sized 0.01 and 0.02 lots, and this backtester cannot reproduce a lot size (#843: it sizes
  // in per-unit shares while the live path sizes in lots) — so without these two columns a
  // difference between two runs could be attributed to the PROTOCOL when the SIZES differed.
  // NULL = a hand-assembled request, or a run made before the column existed. Never read as "equal".
  botId        String?  @db.VarChar(36)
  botBaseSize  Float?
  // ⚠️ ADDED 2026-09-29 (#986) — WHICH WINDOW this run measured. Without it a period comparison
  // and a protocol comparison are indistinguishable in this table, so a difference produced by the
  // DATES could be credited to the PROTOCOL. NULL = not period-scoped (every run before this
  // column, and any plain day-range run) — deliberately distinct from the id of a period.
  periodId     String?  @db.VarChar(36)
  winRate      Float
  totalPnl     Float
  profitFactor Float
  sharpeRatio  Float
  maxDrawdown  Float
  avgTradePnl  Float
  // Execution realism (#50)
  slippage     Float?   // slippage % used
  spread       Float?   // spread % used
  commission   Float?   // commission per trade ($)
  positionModel String? @db.VarChar(30)  // fixedPercent | fixedDollar | atrEqualRisk | kellyFull | kellyHalf
  accountSize  Float?   // starting account balance
  riskPct      Float?   // risk % per trade
  createdAt    DateTime @default(now())

  symbol Symbol         @relation(fields: [symbolId], references: [id], onDelete: Cascade)
  trades BacktestTrade[]

  @@index([symbolId, protocolId])
  @@index([createdAt])
  @@index([periodId])
}

// ── Backtest Periods (#986) ───────────────────────────────
// A WINDOW a human remembers by its story rather than its dates — the owner's own example:
// "the 300% surge of Greenland Mining when Trump signed a deal, over just 2 days".
//
// ⚠️ THE NAME AND NOTE ARE THE FEATURE, NOT DECORATION. `BacktestRun` already stores startDate and
// endDate, and a run list of dates is unreadable — 400 rows of "2026-03-11 to 2026-03-13" say
// nothing about why any window mattered. Storing the reason next to the dates is what lets a run
// be read months later, and what lets the same window be re-measured without retyping it.
//
// ⚠️ This is NOT a second bar store. The bars stay in `MarketBar` (the table the backtest and the
// #819 replay both read); this row only names a RANGE of it.
model BacktestPeriod {
  id        String   @id @default(uuid()) @db.VarChar(36)
  name      String   @db.VarChar(120)
  note      String?  @db.Text
  symbolId  String   @db.VarChar(36)
  timeframe String   @db.VarChar(10)
  fromDate  DateTime
  toDate    DateTime
  // Which provider supplied the bars for this window. NULL = never imported.
  provider  String?  @db.VarChar(50)
  // Bars present in `marketbar` for this window at the last import.
  // ⚠️ NULL = never imported; 0 = an import ran and found NOTHING (a finding, not a success).
  barCount  Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  symbol Symbol @relation(fields: [symbolId], references: [id], onDelete: Cascade)

  @@index([symbolId, timeframe, fromDate])
  @@index([createdAt])
  // ⚠️ REQUIRED — measured 2026-09-29, the first live call to GET /api/backtest/periods returned
  // HTTP 500: *"The table `backtestperiod` does not exist in the current database."*
  //
  // Prisma's default table name is the MODEL name verbatim, and this database's older tables have
  // no underscore (`marketbar`, `backtestrun`, `backtesttrade`) — which is why they work unmapped
  // on Windows (MySQL lowercases them and they match). A SNAKE_CASE table name does NOT: the model
  // `BacktestPeriod` resolves to `backtestperiod`, never `backtest_period`. The database column/table
  // is fine; only the mapping was missing.
  //
  // ⚠️ This comment deliberately does NOT spell out another model's map directive. It did, and the
  // guard below read the PROSE as the directive: `BacktestPeriod` was resolved to `symbol_route`.
  // A comment that quotes a pattern a parser greps for is a trap for every future parser, not only
  // this one. `validate-schema-safety.cjs` now strips comments before parsing AND self-tests that —
  // but the trap is not worth leaving in place. See the sibling models, e.g. SymbolRoute, for the
  // same shape.
  @@map("backtest_period")
}

model BacktestTrade {
  id         String   @id @default(uuid()) @db.VarChar(36)
  runId      String   @db.VarChar(36)
  symbolId   String   @db.VarChar(36)
  entryDate  DateTime
  entryPrice Float
  exitDate   DateTime
  exitPrice  Float
  direction  String   @db.VarChar(10)  // LONG | SHORT
  pnl        Float
  pnlPct     Float
  exitReason String   @db.VarChar(20)  // TP | SL | EOD
  entryScore Float
  signal     String   @db.VarChar(20)
    // #R14 — the levels the exit was measured against. Nullable because runs made before this
    // recorded only the REASON, and "not recorded" must never render as 0.
    stopLoss   Float?
    takeProfit Float?
    // Execution realism (#50)
    positionSize Float?  // number of shares/contracts
    commission   Float?  // commission deducted ($)

  run    BacktestRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([symbolId])
}

model ProviderHealth {
  id            String   @id @default(uuid()) @db.VarChar(36)
  provider      String   @unique @db.VarChar(50)
  status        String   @db.VarChar(50)
  message       String?  @db.Text
  latencyMs     Int?
  checkedAt     DateTime @default(now())
  credentialsOk Boolean  @default(false)
  endpoint      String?  @db.VarChar(500)

  @@index([status, checkedAt])
}

model ApiActivityLog {
  id           String   @id @default(uuid()) @db.VarChar(36)
  timestamp    DateTime @default(now())
  endpoint     String   @db.VarChar(220)
  method       String   @db.VarChar(12)
  provider     String?  @db.VarChar(80)
  statusCode   Int
  durationMs   Int
  responseSize Int      @default(0)

  @@index([timestamp])
  @@index([provider, timestamp])
  @@index([statusCode, timestamp])
  @@index([method, endpoint])
}

model FaqEntry {
  id        String   @id @default(uuid()) @db.VarChar(36)
  question  String   @db.Text
  answer    String   @db.Text
  category  String   @db.VarChar(100)
  tags      String   @db.VarChar(500)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, order])
  @@index([category])
}

model ApiTrace {
  id           String   @id @default(uuid()) @db.VarChar(36)
  cacheKey     String   @db.VarChar(64)
  url          String   @db.VarChar(500)
  method       String   @db.VarChar(10)
  requestBody  String?  @db.Text
  statusCode   Int      @default(0)
  durationMs   Int      @default(0)
  responseBody String?  @db.Text
  preview      String?  @db.VarChar(1000)
  error        String?  @db.Text
  cached       Boolean  @default(false)
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@index([cacheKey, createdAt])
  @@index([createdAt])
  @@index([expiresAt])
}

model CorrelationPair {
  id          String   @id @default(uuid()) @db.VarChar(36)
  symbolA     String   @map("symbol_a") @db.VarChar(20)
  symbolB     String   @map("symbol_b") @db.VarChar(20)
  correlation Float
  periodDays  Int      @default(90) @map("period_days")
  computedAt  DateTime @default(now()) @map("computed_at")

  @@map("correlation_pair")
  @@unique([symbolA, symbolB, periodDays])
  @@index([symbolA])
  @@index([computedAt])
}

model SymbolCalibration {
  id                  String  @id @default(uuid()) @db.VarChar(36)
  symbol              String  @db.VarChar(20)
  directiveId         String  @db.VarChar(100)
  weightMultiplier    Float   @default(1.0)
  reason              String  @db.VarChar(500)
  decayModifier       Float?
  volatilityAdjustment Float?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([symbol, directiveId])
  @@index([symbol])
}

model NewsSource {
  id               String   @id @default(uuid()) @db.VarChar(36)
  name             String   @unique @db.VarChar(200)
  url              String   @db.VarChar(500)
  reliabilityScore Float    @default(5.0)
  patterns         Json
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  articles     ArticleSample[]
  pubPatterns  PublishingPattern[]
  newsArticles NewsArticle[]
}

model ArticleSample {
  id          String   @id @default(uuid()) @db.VarChar(36)
  sourceId    String   @db.VarChar(36)
  headline    String   @db.Text
  url         String?  @db.VarChar(500)
  sentiment   Float    @default(0)
  fluffScore  Float    @default(0)
  publishedAt DateTime
  createdAt   DateTime @default(now())

  source NewsSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId, publishedAt])
  @@index([publishedAt])
}

model PublishingPattern {
  id            String   @id @default(uuid()) @db.VarChar(36)
  sourceId      String   @db.VarChar(36)
  dayOfWeek     Int
  hourOfDay     Int
  avgSentiment  Float    @default(0)
  articleCount  Int      @default(0)
  createdAt     DateTime @default(now())

  source NewsSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, dayOfWeek, hourOfDay])
}

model NewsArticle {
  id          String   @id @default(uuid()) @db.VarChar(36)
  symbol      String   @db.VarChar(20)
  sourceId    String   @db.VarChar(36)
  category    String   @default("general") @db.VarChar(50)
  headline    String   @db.Text
  url         String   @unique @db.VarChar(250)
  summary     String?  @db.Text
  sentiment   Float    @default(0)
  impact      String   @default("medium") @db.VarChar(20)
  publishedAt DateTime
  importedAt  DateTime @default(now())

  source NewsSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([symbol, publishedAt])
  @@index([category, publishedAt])
  @@index([publishedAt])
}

model NewsImportRun {
  id           String   @id @default(uuid()) @db.VarChar(36)
  status       String   @default("running") @db.VarChar(50)
  tierId       String?  @db.VarChar(50)
  symbolsCount Int      @default(0)
  fetched      Int      @default(0)
  newArticles  Int      @default(0)
  duplicates   Int      @default(0)
  errors       Int      @default(0)
  errorLog     String?  @db.Text
  startedAt    DateTime @default(now())
  completedAt  DateTime?

  @@index([startedAt])
  @@index([tierId, startedAt])
}

// RSS news items — RssScraperService destination (ticker-matched headlines).
// Feeds the screener news ingestion (#648).
model NewsItem {
  id          Int       @id @default(autoincrement())
  title       String    @db.VarChar(300)
  url         String?   @db.VarChar(500)
  source      String    @db.VarChar(100)
  sourceHash  String    @unique @db.VarChar(32)
  publishedAt DateTime? @db.DateTime(3)
  summary     String?   @db.Text
  symbols     String?   @db.VarChar(200)
  sentiment   String?   @db.VarChar(50)
  severity    Int       @default(0)
  status      String    @default("new") @db.VarChar(20)
  createdAt   DateTime  @default(now()) @db.DateTime(3)

  @@map("news_item")
  @@index([publishedAt])
}

model DirectiveOutcome {
  id               String    @id @default(uuid()) @db.VarChar(36)
  directiveId      String    @db.VarChar(100)
  symbol           String    @db.VarChar(20)
  strategyId       String?   @db.VarChar(36)
  timeframe        String    @db.VarChar(10)
  score            Float
  signalClass      String    @db.VarChar(10)  // bullish | bearish | neutral
  confidence       Float
  predictedAt      DateTime
  priceAtPredict   Float
  priceT15m        Float?
  priceT1h         Float?
  priceT4h         Float?
  priceT24h        Float?
  directionCorrect Boolean?
  outcomeComputedAt DateTime?
  createdAt        DateTime  @default(now())

  @@index([directiveId, symbol, predictedAt])
  @@index([predictedAt])
  @@index([directionCorrect])
  // ⚠️ REQUIRED by the retention policy, not an optimisation. `createdAt` is this table's
  // retention column (see `retention.config.ts`) — it was changed from `predictedAt` because a
  // bound keyed on a DERIVED value deleted a mis-stamped row immediately, destroying the evidence
  // of the very defect being investigated (#827).
  //
  // Adding this index is what makes that fix VIABLE: the prune is
  // `WHERE createdAt < cutoff`, and without an index that is a full scan of a ~1.5 GB table on
  // every retention run. Measured 2026-09-16 — `SELECT MIN(createdAt)` took 32,298ms unindexed,
  // which alone exceeded the 30s gateway timeout and returned 504 for /api/system/health-dashboard,
  // leaving the whole Health page stuck on a loading skeleton.
  //
  // A retention column without an index is a latent outage, so `validate-retention-columns.cjs`
  // now fails the build if one is declared that no index can serve.
  @@index([createdAt])
}

model MarketSnapshot {
  id              String   @id @default(uuid()) @db.VarChar(36)
  symbol          String   @db.VarChar(20)
  timeframe        String   @db.VarChar(20)
  startTime       DateTime
  endTime         DateTime
  candleData      Json
  directiveScores Json?
  notes           String?  @db.Text
  starred         Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([symbol])
  @@index([starred, createdAt])
}

model AppSetting {
  id    String @id @db.VarChar(100)
  value Json
}

model FeatureFlag {
  id          String   @id @db.VarChar(100)
  enabled     Boolean  @default(false)
  description String?  @db.VarChar(500)
  updatedAt   DateTime @updatedAt
}

// ── Chart Snapshot ────────────────────────────────────────
// Captures chart STATE (not a screenshot image):
// symbol, timeframe, indicators, drawings, annotations.
// Foundation for sharing analysis moments and timeline integration.

model ChartSnapshot {
  id          String   @id @default(uuid()) @db.VarChar(36)
  symbol      String   @db.VarChar(20)
  timeframe   String   @db.VarChar(20)
  indicators  Json     @default("[]")   // [{ id, params }] — which indicators were active
  drawings    Json     @default("[]")   // [{ type, points, label }] — lines, zones, text
  annotations String?  @db.Text         // User notes / analysis text
  visibleRange Json?                    // { from, to } — chart zoom state
  priceAtTime Float?                    // Snapshot price when captured
  tags        Json     @default("[]")   // ["earnings", "breakout", "support-test"]
  createdAt   DateTime @default(now())

  @@index([symbol])
  @@index([symbol, createdAt])
  @@index([createdAt])
}

model ProtocolVersion {
  id         String   @id @default(uuid()) @db.VarChar(36)
  strategyId String   @db.VarChar(36)
  version    String   @db.VarChar(20)
  changes    String   @db.Text
  detectedAt DateTime @default(now())
  previousVersion String? @db.VarChar(20)

  strategy Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  @@index([strategyId, detectedAt])
}

model MacroIndicator {
  id        String   @id @default(uuid()) @db.VarChar(36)
