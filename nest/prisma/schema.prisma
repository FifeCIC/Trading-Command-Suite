model Position {
  id          String   @id @default(uuid()) @db.VarChar(36)
  symbol      String   @db.VarChar(20)
  symbolId    String?  @db.VarChar(36)
  symbolRef   Symbol?  @relation(fields: [symbolId], references: [id], onDelete: SetNull)
  quantity    Float
  avgPrice    Float
  currentPrice Float?
  pnl         Float?
  provider    String   @db.VarChar(50)
