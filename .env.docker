# Docker Environment — copy to .env and fill in secrets
# Used by docker-compose.yml

# MySQL
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_PASSWORD=tradingcs_dev_2026

# Alpaca API (optional — adapter will use mock/throw if missing)
ALPACA_API_KEY=
ALPACA_API_SECRET=

# Queue mode (off = no Redis required; local = requires Redis at localhost:6379)
QUEUE_MODE=off
